---
/**
 * Gabarit commun des pages offres (textes : dossier éditorial V2, oct. 2026) :
 * hero ciblé → intro → prestations → prix (montant + conditions) → blocs propres à l'offre
 * → déroulement → avis → simulateur → FAQ → maillage → CTA.
 * JSON-LD : Service + FAQPage + BreadcrumbList.
 */
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import ReassuranceBar from './ReassuranceBar.astro';
import EnergyScale from './EnergyScale.astro';
import Reviews from './Reviews.astro';
import Faq from './Faq.astro';
import QuoteForm from './QuoteForm.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { getOffer, OFFERS } from '../lib/offers';
import { prixDes, prixLabel } from '../lib/pricing';
import { SITE } from '../lib/site';
import { WORDING } from '../lib/wording';
import { service, faqPage, breadcrumb } from '../lib/jsonld';

interface Props { slug: string }
const { slug } = Astro.props;
const offer = getOffer(slug)!;
const autres = OFFERS.filter((o) => o.slug !== slug);
// Simulateur de devis (QuoteForm, composant UNIQUE) embarqué dans le hero sur TOUTES les
// offres, + 2e instance plus bas (#simulateur). `isPack` (vente/location) pilote seulement
// le teaser d'estimation : pack = estimation teasée puis dévoilée au contact (variante A,
// gagnante du test A/B ×4) ; DPE/audit = cadrage « tarif par email » (revealEstimation=false).
const isPack = offer.demande === 'vente' || offer.demande === 'location';

const jsonLd = [
  service({ name: offer.nav, description: offer.metaDesc, url: offer.url, priceFrom: prixDes(offer.demande), priceTo: offer.prixTo }),
  faqPage(offer.faq),
  breadcrumb([
    { name: 'Accueil', url: '/' },
    { name: offer.nav, url: offer.url },
  ]),
];

const etapes = [
  { h: 'Votre demande', p: 'Décrivez votre projet et votre bien. Votre demande de devis prend environ 2&nbsp;minutes.' },
  { h: 'Confirmation', p: 'Nous confirmons les prestations, le prix et le créneau d’intervention.' },
  { h: 'Intervention', p: offer.processStep3 },
];
---
<Base title={offer.title} description={offer.metaDesc} path={offer.url} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a> <span>/</span> <span aria-current="page">{offer.nav}</span>
    </nav>
  </div>

  <Hero
    tagpill={offer.tagpill ?? 'Paris et Île-de-France · Diagnostiqueur certifié'}
    h1={offer.h1}
    sub={offer.tagline}
    primaryHref={offer.heroCtaHref ?? `/devis?type=${offer.demande}`}
    primaryLabel="Demander mon devis en 2 min"
    secondaryHref="#tarifs"
    secondaryLabel="Voir les tarifs"
    showTrust={true}
    sun={true}
    hideCta={true}
    aside={true}
  >
    <Fragment slot="aside">
      <QuoteForm revealEstimation={isPack} defaultDemande={offer.demande} />
    </Fragment>
  </Hero>

  <ReassuranceBar />

  <!-- Intro — 2 colonnes (texte + CTA à gauche, visuel à droite) -->
  <section class="section-line">
    <div class="wrap">
      <div class:list={['offer-intro', offer.introDark && 'offer-intro--dark', offer.heroImageSide === 'left' && 'offer-intro--img-left']}>
        <div class="offer-intro-copy">
          <div class="eyebrow">En bref</div>
          <h2 class="sec-title">{offer.introTitle}</h2>
          <p class="sec-intro" style="font-size:18.5px;color:var(--ink);max-width:none">{offer.intro}</p>
          <ul class="incl mt-4" style="gap:10px">
            {offer.inclus.slice(0, 3).map((it) => (
              <li>
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span><b>{it.label}</b></span>
              </li>
            ))}
          </ul>
          <div class="flex-cta mt-4">
            <a href="#simulateur" class="btn-blue">Demander mon devis en 2 min</a>
            <a href="#tarifs" class="btn-ghost">Voir les tarifs</a>
          </div>
        </div>
        {offer.heroImage ? (
          <div class="offer-intro-media">
            <ResponsiveImage src={offer.heroImage} alt={offer.heroImageAlt ?? ''} width={620} height={560} sizes="(max-width: 760px) 92vw, 620px" />
          </div>
        ) : (
          <div class="card" style="padding:30px">
            <div class="eyebrow">Exemple d’étiquette</div>
            <p class="muted" style="font-size:14px;margin-bottom:18px">{WORDING.illustration}</p>
            <EnergyScale highlight="C" />
            <p class="mt-3" style="font-family:var(--sora);font-size:12.5px;font-weight:600;color:var(--blue-light);display:flex;align-items:center;gap:8px">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2E6FAE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {SITE.cofracNote}
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Prestations -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Prestations</div>
      <h2 class="sec-title">{offer.inclusTitle}</h2>
      <p class="sec-intro">{offer.inclusIntro}</p>
      <ul class="incl grid grid-2 mt-5">
        {offer.inclus.map((it) => (
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span><b>{it.label}</b><br /><span class="muted" style="font-size:14px" set:html={it.detail} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Prix : montant visible (identique au JSON-LD) + conditions au plus près -->
  <section class="section-line" id="tarifs">
    <div class="wrap">
      <div class="eyebrow">Prix</div>
      <h2 class="sec-title">{offer.prixTitle}</h2>
      <!-- Repère de prix (C07) : montant lu dans pricing.ts (prixLabel), fourchette conservée pour l'audit ;
           les conditions suivent immédiatement dans le même bloc. Hors formulaire. -->
      <div class="v3-prix">
        <p class="v3-prix-montant">{prixLabel(offer.demande).charAt(0).toUpperCase() + prixLabel(offer.demande).slice(1)} TTC</p>
        <p class="sec-intro" style="font-size:18px;color:var(--ink)" set:html={offer.prixText} />
      </div>
      <p class="mt-3"><a href="#simulateur" class="btn-blue">Demander mon devis</a></p>
    </div>
  </section>

  <!-- Blocs propres à l'offre -->
  <section class="section-line">
    <div class="wrap">
      <div class:list={['grid mt-2', offer.blocs.length > 1 && 'grid-2']}>
        {offer.blocs.map((b) => (
          <div class="card offer-bloc">
            <h2>{b.h}</h2>
            <p set:html={b.p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Déroulement -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Déroulement</div>
      <h2 class="sec-title">{offer.processTitle}</h2>
      <p class="sec-intro" set:html={offer.processText} />
      <div class="grid grid-3 mt-5 steps">
        {etapes.map((e, i) => (
          <div class="step"><div class="n">Étape {i + 1}</div><h3>{e.h}</h3><p set:html={e.p} /></div>
        ))}
      </div>
    </div>
  </section>

  <Reviews limit={3} title={`Les retours des clients d’${SITE.legalName}`} eyebrow="Avis Google" />

  <!-- Simulateur en bas de page (2e instance du QuoteForm, désormais instance-safe) —
       cible des CTA / ancre #simulateur. revealEstimation suit isPack. -->
  <section class="section-line" id="simulateur">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow center">Demande de devis</div>
        <h2 class="sec-title">{offer.formTitle}</h2>
        <p class="sec-intro">{offer.formIntro}</p>
      </div>
      <div class="mt-5">
        <QuoteForm revealEstimation={isPack} defaultDemande={offer.demande} />
      </div>
    </div>
  </section>

  <Faq items={offer.faq} title="Questions fréquentes" eyebrow="FAQ" />

  <!-- Maillage interne -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Pour aller plus loin</div>
      <h2 class="sec-title">Informations utiles</h2>
      <ul class="offer-liens mt-4">
        {offer.liens.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <h2 class="sec-title mt-5">Autres prestations</h2>
      <div class="grid grid-3 mt-4">
        {autres.map((o) => (
          <a class="need-card" href={o.url}>
            <h3>{o.nav}</h3>
            <p>{o.navDesc}.</p>
            <span class="go">Voir l’offre
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
      <p class="mt-4"><a href="/tarifs" class="btn-ghost">Voir tous les tarifs</a></p>
    </div>
  </section>

  <!-- CTA final -->
  <section class="cta-final">
    <div class="wrap">
      <h2>{offer.formTitle}</h2>
      <p>{WORDING.engagementDevis}</p>
      <div class="cta">
        <a href="#simulateur" class="btn-gold">Demander mon devis</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .offer-bloc { padding: 28px; }
  .offer-bloc h2 { font-family: var(--sora); font-size: 21px; line-height: 1.3; color: var(--blue); margin: 0 0 10px; }
  .offer-bloc p { margin: 0; color: var(--ink); line-height: 1.6; }
  .offer-bloc :global(a) { color: var(--blue-light); text-decoration: underline; }
  .offer-liens { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .offer-liens a { display: inline-block; padding: 9px 16px; border: 1px solid var(--line, #dbe3ec); border-radius: 999px; font-family: var(--sora); font-size: 14px; font-weight: 600; color: var(--blue); background: #fff; }
  .offer-liens a:hover { border-color: var(--blue-light); }
</style>
