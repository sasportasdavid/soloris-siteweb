---
/**
 * Bloc avis clients : note Google agrégée + cartes d'avis réels.
 * Source unique : SITE.rating (note/nb) + REVIEWS. N'affiche que du réel.
 *
 * Affichage conditionné à la preuve (preuves.ts) : tant que la fiche Google de
 * l'exploitant et la date de contrôle ne sont pas documentées, le bloc affiche la
 * formulation de repli du dossier éditorial (aucun avis, aucune note).
 */
import { SITE } from '../lib/site';
import { REVIEWS } from '../lib/reviews';
import { PREUVES, avisVerifies, AVIS_ATTRIBUTION, REPLI_PREUVE } from '../lib/preuves';
import { WORDING } from '../lib/wording';

interface Props {
  limit?: number;
  title?: string;
  eyebrow?: string;
  compact?: boolean; // version réduite (pour les pages offres, avant le formulaire)
}
const { limit = 3, title = `Les retours des clients d’${SITE.legalName}`, eyebrow = 'Avis Google', compact = false } = Astro.props;
const items = REVIEWS.slice(0, limit);
---
{avisVerifies ? (
  <section class:list={[compact ? '' : 'section-line']}>
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px">
        <div>
          <div class="eyebrow">{eyebrow}</div>
          <h2 class="sec-title" style={compact ? 'font-size:28px' : ''}>{title}</h2>
        </div>
        <div class="rating-agg">
          <span class="big">{SITE.rating.value}</span>
          <span class="muted" style="font-size:14px">Note Google<br /><span style="font-size:12px">{SITE.legalName}</span></span>
        </div>
      </div>
      <div class="grid grid-3 mt-5">
        {items.map((a) => (
          <div class="review">
            <div class="stars" aria-label="5 étoiles sur 5">
              {[0, 1, 2, 3, 4].map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#F4A24A" aria-hidden="true"><path d="M12 2l2.9 6.2 6.8.8-5 4.7 1.3 6.7L12 17.8 5.9 20.4 7.2 13.7l-5-4.7 6.8-.8z"/></svg>
              ))}
            </div>
            <p>« {a.txt} »</p>
            <div class="who">{a.who}<span>{a.sub}</span></div>
          </div>
        ))}
      </div>
      <p class="muted mt-4" style="font-size:13.5px">
        {`${AVIS_ATTRIBUTION} `}<a href={PREUVES.avisGoogle.ficheUrl} rel="noopener" target="_blank">Consulter les avis sur Google</a>
      </p>
    </div>
  </section>
) : (
  <section class:list={[compact ? '' : 'section-line']}>
    <div class="wrap">
      <div class="card proof-repli">
        <div class="eyebrow">Qui intervient ?</div>
        <h2 class="sec-title" style="font-size:26px">{REPLI_PREUVE.titre}</h2>
        <p class="sec-intro" style="max-width:none">{`${REPLI_PREUVE.texte} ${WORDING.certification}`}</p>
      </div>
    </div>
  </section>
)}

<style>
  .proof-repli { padding: 28px 30px; }
</style>
