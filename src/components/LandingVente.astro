---
/**
 * Landing page « parcours vente » nav-strippée, partagée par les 2 bras du test
 * A/B 'price_model' (réparti par URL via l'expérience Google Ads).
 *
 * ⚠️ INTÉGRITÉ DU TEST — SYMÉTRIE STRICTE : tout le contenu (héro, sections, copy,
 * longueur) est IDENTIQUE entre A et B. La SEULE différence autorisée est le
 * traitement du PRIX, au même emplacement (colonne texte du héro, hors formulaire) :
 *   variant 'A' (withPrices=true)  → bloc « Pack vente dès … € TTC » (prixDes('vente'))
 *                                    + tunnel revealEstimation=true
 *   variant 'B' (withPrices=false) → bloc « Un devis adapté à votre bien », AUCUN montant
 *                                    + tunnel revealEstimation=false. Le prix reste CALCULÉ
 *                                    en coulisse et poussé dans lead_submitted.
 * Le tunnel tourne en mode VERROUILLÉ (lockExperiments) pour isoler 'price_model' des
 * tests cookie cta_devis/steps_order. Zéro prix en dur. Textes : dossier éditorial V2 (oct. 2026).
 */
import LandingLayout from '../layouts/LandingLayout.astro';
import ReassuranceBar from './ReassuranceBar.astro';
import ReportPreview from './ReportPreview.astro';
import Reviews from './Reviews.astro';
import ReviewWall from './ReviewWall.astro';
import Faq from './Faq.astro';
import QuoteForm from './QuoteForm.astro';
import { getOffer } from '../lib/offers';
import { prixDes, AGE_LABELS } from '../lib/pricing';
import { PACK_FROM_MAX_M2, WORDING } from '../lib/wording';
import { PREUVES, avisVerifies, AVIS_ATTRIBUTION, REPLI_PREUVE } from '../lib/preuves';
import { SITE } from '../lib/site';

interface Props { variant: 'A' | 'B' }
const { variant } = Astro.props;
const withPrices = variant === 'A';
const recallSla = SITE.rappel.delai;

const offer = getOffer('diagnostics-vente')!;

const title = withPrices
  ? `Pack diagnostics vente dès ${prixDes('vente')} € | Soloris`
  : 'Diagnostics de vente : devis personnalisé | Soloris';
const description = withPrices
  ? `Diagnostics de vente réunis en un rendez-vous. Pack dès ${prixDes('vente')} € TTC selon le bien, déplacement inclus à Paris et en Île-de-France.`
  : 'Diagnostics de vente réunis en une visite à Paris et en Île-de-France. Prestations et prix confirmés au devis, déplacement inclus.';
const path = withPrices ? '/lp/vente-prix' : '/lp/vente-sans-prix';

// FAQ IDENTIQUE A/B — aucun montant (bras B).
const faqVente = [
  { q: 'Quels diagnostics seront réalisés ?', a: 'Ceux nécessaires à votre vente selon le bien et le périmètre convenu. La liste est confirmée avant l’intervention.' },
  { q: 'Le prix est-il annoncé avant la visite ?', a: 'Oui. Nous confirmons les prestations et le prix dans le devis. Une estimation n’est pas une réservation ni un devis définitif.' },
  { q: 'Le pack inclut-il l’audit énergétique ?', a: 'L’audit est une prestation distincte lorsqu’il est requis pour la vente du bien concerné.' },
  { q: 'Quand serai-je recontacté ?', a: `Pendant nos horaires d’ouverture, ${SITE.rappel.horaires}. Hors horaires, votre demande est traitée à la prochaine ouverture.` },
];
---
<LandingLayout title={title} description={description} path={path}>
  <!-- Bandeau d'info slim — IDENTIQUE A/B, NON cliquable (aucun lien : préserve le nav-strip) -->
  <div class="lp-strip">
    <div class="wrap">Diagnostics immobiliers à Paris et en Île-de-France · Déplacement inclus</div>
  </div>

  <!-- Héro 2 colonnes : accroche, prix (A) ou devis (B), preuve, CTA (gauche) · formulaire (droite) -->
  <section class="lp-hero">
    <svg class="lp-hero-sun" viewBox="0 0 100 100" fill="none" aria-hidden="true">
      <circle cx="50" cy="50" r="30" stroke="#2E6FAE" stroke-width="1.4" opacity="0.45" />
      <circle cx="50" cy="50" r="40" stroke="#2E6FAE" stroke-width="1.4" opacity="0.28" />
      <circle cx="50" cy="50" r="49.3" stroke="#2E6FAE" stroke-width="1.4" opacity="0.16" />
      <path d="M 79.9 36.1 A 33 33 0 1 1 63.9 20.1" stroke="#FFC94D" stroke-width="5" stroke-linecap="round" />
      <path d="M 52 48 L 94 6" stroke="#F5A623" stroke-width="5" stroke-linecap="round" />
    </svg>
    <div class="wrap lp-hero-grid">
      <div class="lp-hero-copy">
        <span class="tagpill">
          <svg width="14" height="14" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M 53 47 L 84 16" stroke="#F5A623" stroke-width="12" stroke-linecap="round" /><path d="M 79.9 36.1 A 33 33 0 1 1 63.9 20.1" stroke="#2E6FAE" stroke-width="12" stroke-linecap="round" /></svg>
          Paris et Île-de-France · Diagnostiqueur certifié
        </span>
        <h1>Vos diagnostics de vente, en un seul rendez-vous</h1>
        <p class="lp-sub">Un dossier adapté à votre bien, un prix annoncé avant la visite et des rapports à transmettre à votre notaire.</p>
        <!-- ⚠️ SEUL bloc qui diffère A/B (le PRIX). Même emplacement, poids visuel équivalent. -->
        {withPrices ? (
          <div class="lp-price" id="tarifs">
            <p class="lp-price-amount">Pack vente dès <strong>{prixDes('vente')}&nbsp;€</strong> TTC</p>
            <p class="lp-price-cond">Déplacement inclus à Paris et en Île-de-France. Prix d’entrée pour un appartement de {PACK_FROM_MAX_M2}&nbsp;m² maximum construit depuis {AGE_LABELS.recent.toLowerCase()}. Le prix dépend du bien et des prestations ; il est confirmé au devis.</p>
          </div>
        ) : (
          <div class="lp-price">
            <p class="lp-price-amount">Un devis adapté à votre bien</p>
            <p class="lp-price-cond">Déplacement inclus à Paris et en Île-de-France. Nous précisons les diagnostics nécessaires et le prix de votre intervention avant la visite.</p>
          </div>
        )}
        <div class="lp-proof">
          {PREUVES.portraitEquipe && <img class="lp-avatar" src="/images/diagnostiqueur-soloris-avatar.webp" width="64" height="64" alt="Un diagnostiqueur Soloris" decoding="async" />}
          <div class="lp-proof-txt">
            {avisVerifies ? (
              <>
                <div class="lp-rating" aria-label={`${SITE.legalName} : note ${SITE.rating.value} sur 5, ${SITE.rating.count} avis Google`}>
                  <span class="stars" aria-hidden="true">
                    {[0,1,2,3,4].map(() => <svg width="16" height="16" viewBox="0 0 24 24" fill="#F4A24A"><path d="M12 2l2.9 6.2 6.8.8-5 4.7 1.3 6.7L12 17.8 5.9 20.4 7.2 13.7l-5-4.7 6.8-.8z"/></svg>)}
                  </span>
                  <strong>{SITE.legalName} : {SITE.rating.value}/5</strong> sur Google — {SITE.rating.count} avis
                </div>
                <span class="lp-who">{AVIS_ATTRIBUTION} <a href={PREUVES.avisGoogle.ficheUrl} target="_blank" rel="noopener">Consulter les avis sur Google</a></span>
              </>
            ) : (
              <>
                <strong class="lp-who-title">{REPLI_PREUVE.titre}</strong>
                <span class="lp-who">{REPLI_PREUVE.texte}</span>
              </>
            )}
          </div>
        </div>
        <div class="lp-cta"><a href="#simulateur" class="btn-gold">Demander mon devis en 2 min</a></div>
        <div class="lp-trust">
          <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2E6FAE" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Prix annoncé avant la visite</span>
          <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2E6FAE" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Déplacement inclus</span>
          <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2E6FAE" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Diagnostiqueur certifié</span>
        </div>
      </div>
      <div class="lp-hero-visual">
        <QuoteForm
          lockExperiments={true}
          forceCta="A"
          forceSteps="A"
          priceModelVariant={variant}
          revealEstimation={withPrices}
          defaultDemande="vente"
          recallSla={recallSla}
        />
      </div>
    </div>
  </section>

  <ReassuranceBar />

  <!-- Toutes les sections suivantes sont IDENTIQUES A/B -->
  <section class="section-line">
    <div class="wrap" style="max-width:820px">
      <div class="eyebrow">Votre vente</div>
      <h2 class="sec-title">Les diagnostics nécessaires, sans multiplier les démarches</h2>
      <p class="sec-intro">Nous faisons le point sur votre bien et regroupons les diagnostics prévus en une visite. Vous connaissez les prestations et le prix avant l’intervention.</p>
    </div>
  </section>

  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Le contenu</div>
      <h2 class="sec-title">Ce que comprend votre dossier de vente</h2>
      <p class="sec-intro">DPE, état des risques et diagnostics complémentaires selon le logement : amiante, plomb, électricité, gaz, mesurage ou termites lorsque le bien est concerné. La composition est confirmée au devis.</p>
      <ul class="incl grid grid-2 mt-5">
        {offer.inclus.map((it) => (
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span><b>{it.label}</b><br /><span class="muted" style="font-size:14px" set:html={it.detail} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-line">
    <div class="wrap" style="max-width:820px">
      <div class="eyebrow">Votre bien</div>
      <h2 class="sec-title">Appartement ou maison : le bon périmètre</h2>
      <p class="sec-intro">Précisez les lots annexes, les installations et les rapports déjà disponibles. Un audit énergétique peut être requis pour certaines maisons ou certains immeubles en monopropriété ; il constitue une prestation distincte.</p>
    </div>
  </section>

  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Déroulement</div>
      <h2 class="sec-title">De la demande aux rapports</h2>
      <div class="grid grid-3 mt-5 steps">
        <div class="step"><div class="n">Étape 1</div><h3>Votre demande</h3><p>Décrivez votre bien en environ 2 minutes.</p></div>
        <div class="step"><div class="n">Étape 2</div><h3>Diagnostics, prix et rendez-vous</h3><p>Nous confirmons les diagnostics, le prix et le rendez-vous.</p></div>
        <div class="step"><div class="n">Étape 3</div><h3>Visite et rapports</h3><p>Les diagnostics sont réalisés et les rapports transmis. Le délai est confirmé pour votre dossier ; les rapports de diagnostics sont généralement remis sous 24&nbsp;h après la visite.</p></div>
      </div>
    </div>
  </section>

  <section class="section-line" id="rapport-type">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow center">Exemple de rapport</div>
        <h2 class="sec-title">Des rapports à transmettre à votre notaire</h2>
        <p class="sec-intro">Vous recevez les résultats des prestations commandées. L’exemple présenté illustre la mise en forme ; il ne préjuge pas des résultats de votre logement.</p>
      </div>
      <div class="mt-5" style="max-width:880px;margin-left:auto;margin-right:auto"><ReportPreview /></div>
    </div>
  </section>

  <Reviews limit={3} title={`Les retours des clients d’${SITE.legalName}`} eyebrow="Avis Google" />

  <!-- Tunnel de devis (mode verrouillé) — heading IDENTIQUE A/B -->
  <section class="section-line">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow center">Demande de devis</div>
        <h2 class="sec-title">Préparez vos diagnostics de vente</h2>
        <p class="sec-intro">Votre demande est gratuite et sans engagement. Le créneau est confirmé avec vous, il n’est pas réservé automatiquement par le formulaire.</p>
      </div>
      <div class="mt-5" id="simulateur">
        <QuoteForm
          lockExperiments={true}
          forceCta="A"
          forceSteps="A"
          priceModelVariant={variant}
          revealEstimation={withPrices}
          defaultDemande="vente"
          recallSla={recallSla}
        />
      </div>
    </div>
  </section>

  <Faq items={faqVente} title="Vos questions sur les diagnostics de vente" eyebrow="FAQ" />

  <ReviewWall />

  <!-- CTA final — IDENTIQUE A/B -->
  <section class="cta-final">
    <div class="wrap">
      <h2>Votre dossier de diagnostics, en toute clarté</h2>
      <p>{WORDING.engagementDevis}</p>
      <div class="cta"><a href="#simulateur" class="btn-gold">Demander mon devis en 2 min</a></div>
    </div>
  </section>
</LandingLayout>

<style>
  .lp-strip { background: var(--blue); color: #fff; }
  .lp-strip .wrap { text-align: center; font-family: var(--sora); font-weight: 500; font-size: 12.5px; letter-spacing: .01em; padding: 9px 0; }
  .lp-hero { position: relative; overflow: hidden; padding: 52px 0 40px; background: linear-gradient(180deg, var(--paper), #fff); }
  .lp-hero-sun { position: absolute; top: -90px; right: -120px; width: 460px; height: 460px; opacity: .5; pointer-events: none; }
  .lp-hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: center; }
  .lp-hero-copy .tagpill { display: inline-flex; align-items: center; gap: 7px; font-family: var(--sora); font-weight: 600; font-size: 12.5px; color: var(--blue-light); background: rgba(46,111,174,.09); border-radius: 999px; padding: 6px 14px; margin-bottom: 18px; }
  .lp-hero-copy h1 { font-family: var(--sora); font-weight: 600; font-size: clamp(28px, 3.4vw, 42px); color: var(--blue); letter-spacing: -.01em; line-height: 1.12; }
  .lp-sub { font-size: 18px; color: var(--ink-soft); margin-top: 14px; max-width: 520px; line-height: 1.5; }
  .lp-price { margin-top: 20px; max-width: 520px; border-left: 3px solid var(--gold); padding: 4px 0 4px 14px; }
  .lp-price-amount { font-family: var(--sora); font-size: 18px; color: var(--blue); font-weight: 600; }
  .lp-price-amount strong { font-size: 26px; font-weight: 600; }
  .lp-price-cond { font-size: 14px; color: var(--ink); margin-top: 4px; line-height: 1.5; }
  .lp-rating { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-family: var(--sora); font-size: 13.5px; color: var(--ink-soft); }
  .lp-rating .stars { display: inline-flex; gap: 1px; }
  .lp-rating strong { color: var(--blue); }
  .lp-proof { display: flex; align-items: center; gap: 14px; margin-top: 18px; }
  .lp-avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: none; border: 2px solid #fff; box-shadow: 0 2px 10px rgba(11,42,74,.18); }
  .lp-who-title { display: block; font-family: var(--sora); font-weight: 600; font-size: 14px; color: var(--blue); }
  .lp-who { display: block; margin-top: 3px; font-family: var(--sora); font-size: 13px; color: var(--ink-soft); }
  .lp-who a { color: var(--blue-light); text-decoration: underline; }
  .lp-cta { margin-top: 24px; }
  .lp-trust { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 22px; font-family: var(--sora); font-weight: 500; font-size: 13px; color: var(--blue-light); }
  .lp-trust span { display: inline-flex; align-items: center; gap: 7px; }
  .lp-hero-visual { position: relative; }
  @media (max-width: 820px) {
    .lp-hero-grid { grid-template-columns: 1fr; gap: 30px; }
    .lp-hero-visual { max-width: 460px; }
  }
</style>
