---
/**
 * /guides — hub SEO de fond. Maille vers les offres et tarifs.
 */
import Base from '../../layouts/Base.astro';
import { GUIDES } from '../../lib/guides';
import { breadcrumb } from '../../lib/jsonld';
import { WORDING } from '../../lib/wording';

const jsonLd = [breadcrumb([{ name: 'Accueil', url: '/' }, { name: 'Guides', url: '/guides' }])];
---
<Base
  title="Guides du diagnostic immobilier | Soloris"
  description="Prix, diagnostics obligatoires et DPE : les guides Soloris pour préparer votre vente ou votre location avec des informations datées et sourcées."
  path="/guides"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span>/</span> <span aria-current="page">Guides</span></nav>
  </div>

  <section>
    <div class="wrap">
      <div class="eyebrow">Guides</div>
      <h1 class="sec-title" style="font-size:44px">Comprendre vos diagnostics avant de vous lancer</h1>
      <p class="sec-intro">Des guides pour préparer votre projet, lire un rapport et distinguer les obligations applicables des prestations utiles.</p>

      <div class="grid grid-3 mt-5">
        {GUIDES.map((g) => (
          <a class="need-card" href={g.url}>
            <span class="muted" style="font-family:var(--sora);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--blue-light)">Guide · {g.readMin} min</span>
            <h3>{g.h1}</h3>
            <p>{g.excerpt}</p>
            <span class="go">Lire le guide
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
      <p class="muted mt-5" style="font-size:14.5px;max-width:760px"><strong>Des informations à replacer dans votre situation.</strong> Les guides présentent les règles générales et leurs sources. La composition de votre dossier dépend de votre bien, de vos documents et de votre projet.</p>
    </div>
  </section>

  <section class="cta-final">
    <div class="wrap">
      <h2>Une question sur votre bien&nbsp;?</h2>
      <p>{WORDING.engagementDevis}</p>
      <div class="cta"><a href="/devis" class="btn-gold">Demander mon devis</a></div>
    </div>
  </section>
</Base>
