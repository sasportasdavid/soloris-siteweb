---
import Base from '../../layouts/Base.astro';
import EnergyScale from '../../components/EnergyScale.astro';
import GuideSources from '../../components/GuideSources.astro';
import { getGuide } from '../../lib/guides';
import { WORDING } from '../../lib/wording';
import { article, breadcrumb, faqPage } from '../../lib/jsonld';

const g = getGuide('comprendre-etiquette-dpe')!;
const faq = [
  { q: 'Soloris peut-il me garantir une meilleure note ?', a: 'Non. L’engagement porte sur la réalisation de la mission et l’explication du rapport, jamais sur une classe déterminée.' },
  { q: 'Un changement de coefficient réduit-il ma facture ?', a: 'Il modifie le calcul conventionnel concerné, pas directement les consommations physiques ou le tarif de votre contrat d’énergie.' },
  { q: 'Combien de temps un DPE est-il valable ?', a: 'Un DPE réalisé depuis le 1er juillet 2021 est en principe valable 10 ans. Les DPE réalisés avant cette date ne sont plus valides depuis le 1er janvier 2025.' },
];
const jsonLd = [
  article({ headline: g.h1, description: g.description, url: g.url, datePublished: g.datePublished, dateModified: g.dateModified }),
  breadcrumb([{ name: 'Accueil', url: '/' }, { name: 'Guides', url: '/guides' }, { name: g.h1, url: g.url }]),
  faqPage(faq),
];
---
<Base title={g.title} description={g.description} path={g.url} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span>/</span> <a href="/guides">Guides</a> <span>/</span> <span aria-current="page">Étiquette DPE</span></nav>
  </div>
  <article>
    <section>
      <div class="wrap prose">
        <div class="eyebrow">Guide · {g.readMin} min</div>
        <h1 class="sec-title v3-page-title v3-guide-title">{g.h1}</h1>
        <p class="lead">{g.excerpt}</p>

        <h2>Que signifient les lettres A à G ?</h2>
        <p>Le DPE classe la performance énergétique et renseigne les émissions de gaz à effet de serre. La classe dépend des seuils applicables et des résultats du logement ; une annonce de diagnostic ne peut donc pas promettre une lettre à l’avance.</p>
        <div class="card" style="padding:26px;margin:8px 0 22px">
          <EnergyScale highlight="C" />
          <p class="muted" style="font-size:13px;margin:14px 0 0">{WORDING.illustration}</p>
        </div>

        <h2>Pourquoi la facture peut être différente</h2>
        <p>Le calcul repose sur des hypothèses conventionnelles et les caractéristiques du bien. Les usages, les occupants, la météo et les contrats d’énergie influencent les factures réellement payées. Ne comparez pas directement un montant facturé et un indicateur du DPE comme s’ils mesuraient exactement la même chose.</p>

        <h2>Quelles informations vérifier dans le rapport ?</h2>
        <p>Contrôlez l’adresse, la surface de référence, les équipements et les informations décrivant le logement. Conservez les justificatifs utiles, notamment ceux concernant les travaux et les installations. Une difficulté de compréhension doit être examinée avec le professionnel ; elle ne justifie pas de choisir arbitrairement une classe plus favorable.</p>

        <h2>Que faire des recommandations ?</h2>
        <p>Les recommandations aident à comprendre les possibilités d’amélioration. Elles ne remplacent pas des devis d’entreprises ni l’étude détaillée d’un projet de rénovation. Un <a href="/audit-energetique">audit énergétique</a> peut approfondir les scénarios lorsqu’il est pertinent ou obligatoire.</p>

        <h2>Les changements de méthode ne sont pas des travaux</h2>
        <p>Les évolutions réglementaires du calcul peuvent modifier l’étiquette de certains logements sans changer leur consommation réelle. Consultez notre <a href="/guides/reforme-dpe">guide sur les réformes</a> pour distinguer les règles en vigueur en 2026 de celles prévues en 2027, ainsi que les possibilités d’attestation officielle.</p>

        <h2>Vendre ou louer : examiner le dossier complet</h2>
        <p>Le DPE fait partie d’un ensemble d’informations. Pour louer, sa classe et les autres critères de décence doivent être vérifiés. Pour vendre, d’autres diagnostics et parfois un audit peuvent être nécessaires. Soloris précise le périmètre à prévoir pour votre projet.</p>

        <h2>Pour aller plus loin</h2>
        <ul>
          <li><a href="/dpe">DPE seul</a></li>
          <li><a href="/guides/reforme-dpe">Réformes du DPE : 2026 et 2027</a></li>
          <li><a href="/audit-energetique">Audit énergétique</a></li>
          <li><a href="/diagnostics-location">Diagnostics pour louer</a></li>
        </ul>

        <GuideSources guide={g} />
      </div>
    </section>

    <section class="cta-final">
      <div class="wrap">
        <h2>Votre DPE, expliqué</h2>
        <p>Demande gratuite et sans engagement. Le prix est confirmé avant l’intervention.</p>
        <div class="cta">
          <a href="/devis?type=dpe" class="btn-gold">Demander mon devis</a>
          <a href="/dpe" class="btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.3)">Voir l'offre DPE</a>
        </div>
      </div>
    </section>
  </article>
</Base>
