---
/**
 * /devis — page de conversion. Formulaire multi-étapes + estimation.
 */
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../lib/site';
import { breadcrumb } from '../lib/jsonld';

const jsonLd = [breadcrumb([{ name: 'Accueil', url: '/' }, { name: 'Devis', url: '/devis' }])];
---
<Base
  title="Demande de devis diagnostic immobilier | Soloris"
  description="Décrivez votre bien et demandez votre devis gratuit de diagnostic immobilier à Paris ou en Île-de-France. Prix confirmé avant la visite."
  path="/devis"
  jsonLd={jsonLd}
  hideHeaderCta={true}
>
  <section>
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow center">Demande de devis</div>
        <h1 class="sec-title" style="font-size:40px">Demandez votre devis de diagnostic immobilier</h1>
        <p class="sec-intro">Quelques questions sur votre projet et votre bien. Nous vous recontactons pour confirmer les diagnostics nécessaires, le prix et les disponibilités.</p>
      </div>
      <div class="mt-5">
        <QuoteForm />
      </div>
      <div class="text-center muted mt-4" style="font-size:13.5px;max-width:600px;margin-left:auto;margin-right:auto">
        <p><strong>Votre demande, sans engagement.</strong> Les montants éventuellement affichés sont des estimations établies à partir des informations saisies. Votre prix est confirmé au devis avant l’intervention.</p>
        <p class="mt-2"><strong>Après votre demande.</strong> Nous traitons les demandes {SITE.rappel.horaires}. Le rendez-vous est confirmé avec vous ; il n’est pas réservé automatiquement à l’envoi du formulaire.</p>
      </div>
    </div>
  </section>
</Base>
