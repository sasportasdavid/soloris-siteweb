---
/**
 * /diagnostics — hub « Tous les diagnostics ».
 * Liste l'ensemble des diagnostics (DPE & Audit → pages offres existantes ;
 * les autres → pages dédiées /diagnostics/{slug} quand elles sont prêtes,
 * sinon CTA devis). JSON-LD : FAQPage + Breadcrumb.
 */
import Base from '../../layouts/Base.astro';
import ReassuranceBar from '../../components/ReassuranceBar.astro';
import Faq from '../../components/Faq.astro';
import { DIAGNOSTICS } from '../../lib/diagnostics';
import { prixDes, prixLabel } from '../../lib/pricing';
import { faqPage, breadcrumb } from '../../lib/jsonld';

// Carte « DPE » et « Audit » pointent vers les pages offres existantes.
type Card = { name: string; desc: string; price: string; href: string };
const cards: Card[] = [
  { name: 'DPE', desc: 'Diagnostic de Performance Énergétique (étiquette A→G).', price: `dès ${prixDes('dpe')} €`, href: '/dpe' },
  { name: 'Audit énergétique', desc: 'Scénarios de travaux pour les logements énergivores.', price: prixLabel('audit'), href: '/audit-energetique' },
  ...DIAGNOSTICS.map((d) => ({
    name: d.name,
    desc: d.tagline,
    price: d.priceLabel,
    href: d.ready ? `/diagnostics/${d.slug}` : '/devis',
  })),
];

const faq = [
  { q: 'Quels diagnostics sont obligatoires pour vendre ?', a: "Selon le bien : DPE et ERP, complétés par l'amiante, le plomb, l'électricité, le gaz, le mesurage Loi Carrez et, en zone concernée, les termites. Nous établissons la liste applicable au devis." },
  { q: 'Quels diagnostics pour louer ?', a: 'Généralement le DPE et l’ERP, complétés selon le logement par le plomb, l’électricité, le gaz et le mesurage Loi Boutin.' },
  { q: 'Puis-je regrouper mes diagnostics ?', a: 'Oui : nos packs vente et location réunissent les diagnostics nécessaires en un seul rendez-vous. L’état des risques est inclus dans les packs. La composition est confirmée au devis.' },
];

const jsonLd = [
  faqPage(faq),
  breadcrumb([{ name: 'Accueil', url: '/' }, { name: 'Tous les diagnostics', url: '/diagnostics' }]),
];
---
<Base
  title="Les diagnostics immobiliers : vente et location | Soloris"
  description="Amiante, plomb, gaz, électricité, mesurages et état des risques : comprenez les diagnostics nécessaires pour votre vente ou votre location."
  path="/diagnostics"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span>/</span> <span aria-current="page">Tous les diagnostics</span></nav>
  </div>

  <section>
    <div class="wrap">
      <div class="eyebrow">Le référentiel</div>
      <h1 class="sec-title v3-page-title">Quels diagnostics pour votre bien ?</h1>
      <p class="sec-intro">Chaque diagnostic répond à une question précise. Retrouvez son rôle et les situations concernées, puis faites confirmer la composition de votre dossier.</p>
    </div>
  </section>

  <ReassuranceBar />

  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Diagnostic par diagnostic</div>
      <h2 class="sec-title">Découvrez chaque diagnostic</h2>
      <p class="sec-intro" style="max-width:none">Amiante : repérage selon l’époque du permis. Plomb : risque lié aux revêtements des logements anciens. Électricité et gaz : état des installations. Carrez et Boutin : superficies. État des risques : information liée à l’adresse. Termites : zones concernées.</p>
      <div class="grid grid-3 mt-5">
        {cards.map((c) => (
          <a class="need-card" href={c.href}>
            <h3>{c.name}</h3>
            <p>{c.desc}</p>
            <span class="go">{c.price.startsWith('dès') ? `${c.price} TTC` : c.price}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
      <p class="muted mt-4" style="font-size:13.5px">« Dès » : prix d’entrée TTC, déplacement inclus. Le montant dépend du bien et des prestations nécessaires ; il est confirmé au devis. Termites : sur devis selon le secteur.</p>
    </div>
  </section>

  <!-- Packs -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Les packs</div>
      <h2 class="sec-title">Pour vendre ou pour louer</h2>
      <p class="sec-intro">Un seul rendez-vous pour les diagnostics nécessaires. L’état des risques est inclus dans les packs.</p>
      <div class="grid grid-2 mt-5">
        <a class="need-card" href="/diagnostics-vente"><h3>Pour vendre</h3><p>Le dossier dépend du bien et du projet. Notre pack vente regroupe les diagnostics applicables, confirmés avant l’intervention.</p><span class="go">Dès {prixDes('vente')} € TTC
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
        <a class="need-card" href="/diagnostics-location"><h3>Pour louer</h3><p>Le DPE et les diagnostics complémentaires sont à prévoir selon le logement et les rapports encore valides. Le mesurage de la surface habitable répond à un besoin distinct.</p><span class="go">Dès {prixDes('location')} € TTC
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
      </div>
    </div>
  </section>

  <Faq items={faq} title="Questions fréquentes" />

  <section class="cta-final">
    <div class="wrap">
      <h2>Vous avez besoin d’une seule prestation&nbsp;?</h2>
      <p>Consultez la fiche correspondante et appelez-nous pour préciser la mission. Le formulaire de devis en ligne organise principalement les projets de vente, location, DPE et audit ; nous confirmons votre demande avant toute intervention.</p>
      <div class="cta"><a href="/devis" class="btn-gold">Demander mon devis</a></div>
    </div>
  </section>
</Base>
