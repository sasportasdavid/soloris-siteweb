---
/**
 * Gabarit d'une page diagnostic : /diagnostics/{slug}
 * Génère uniquement les diagnostics `ready` (phase de validation).
 * JSON-LD : Service + FAQPage + BreadcrumbList. Maillage vers les packs + /devis.
 * Conforme : factuel, aucune promesse de résultat, prix = grille.
 * Textes : dossier éditorial V2 (oct. 2026) ; sources officielles en bas de fiche.
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ReassuranceBar from '../../components/ReassuranceBar.astro';
import Faq from '../../components/Faq.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { DIAGNOSTICS, type Diagnostic } from '../../lib/diagnostics';
import { getOffer } from '../../lib/offers';
import { service, faqPage, breadcrumb } from '../../lib/jsonld';
import { prixDes } from '../../lib/pricing';
import { SITE } from '../../lib/site';
import { WORDING } from '../../lib/wording';
import { sourcesFor } from '../../lib/sources';

export function getStaticPaths() {
  return DIAGNOSTICS.filter((d) => d.ready).map((d) => ({ params: { diag: d.slug }, props: { diag: d } }));
}

interface Props { diag: Diagnostic }
const { diag } = Astro.props;
const url = `/diagnostics/${diag.slug}`;

const packLinks = diag.inPack.map((p) => getOffer(p === 'vente' ? 'diagnostics-vente' : 'diagnostics-location')!);

// Prix numérique pour le JSON-LD (omis si « sur devis »)
const priceMatch = diag.priceLabel.match(/(\d+)/);
const priceFrom = priceMatch ? Number(priceMatch[1]) : undefined;

const sources = sourcesFor(diag.sources);
const telHref = `tel:${SITE.phone.replace(/\s/g, '')}`;

const jsonLd = [
  // Électricité / gaz : le prix porte sur la prestation COMBINÉE (offerName), jamais sur un prix à l'unité.
  service({ name: diag.offerName ?? diag.name, description: diag.metaDesc, url, priceFrom }),
  faqPage(diag.faq),
  breadcrumb([
    { name: 'Accueil', url: '/' },
    { name: 'Tous les diagnostics', url: '/diagnostics' },
    { name: diag.name, url },
  ]),
];
---
<Base title={diag.title} description={diag.metaDesc} path={url} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a> <span>/</span> <a href="/diagnostics">Tous les diagnostics</a> <span>/</span> <span aria-current="page">{diag.name}</span>
    </nav>
  </div>

  <Hero
    h1={diag.h1}
    sub={diag.tagline}
    showTrust={true}
    sun={true}
    hideCta={true}
    aside={true}
  >
    <Fragment slot="aside">
      <QuoteForm revealEstimation={true} />
    </Fragment>
  </Hero>

  <ReassuranceBar />

  <!-- Ce que c'est + quand c'est obligatoire (2 colonnes) -->
  <section class="section-line">
    <div class="wrap">
      {diag.image ? (
        <div class:list={['split-media', diag.slug === 'electricite' && 'split-media--reverse']}>
          <div class="split-media-img">
            <ResponsiveImage src={diag.image} alt={diag.imageAlt ?? ''} width={620} height={640} sizes="(max-width: 760px) 92vw, 620px" />
          </div>
          <div class="split-media-body">
            <div class="eyebrow">En quoi consiste ce diagnostic</div>
            <h2 class="sec-title" style="font-size:30px">{diag.name}</h2>
            <p class="sec-intro" style="font-size:18px;color:var(--ink);max-width:none">{diag.intro}</p>
            <div class="eyebrow mt-4">Quand le prévoir&nbsp;?</div>
            <ul class="incl mt-3" style="gap:12px">
              {diag.when.map((w) => (
                <li>
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  <span set:html={w} />
                </li>
              ))}
            </ul>
            <p class="muted mt-3" style="font-size:13px">Nous confirmons si ce diagnostic s’applique à votre bien au moment du devis, selon la réglementation en vigueur.</p>
          </div>
        </div>
      ) : (
        <div class="grid grid-2" style="align-items:start;gap:44px">
          <div>
            <div class="eyebrow">En quoi consiste ce diagnostic</div>
            <h2 class="sec-title" style="font-size:30px">{diag.name}</h2>
            <p class="sec-intro" style="font-size:18px;color:var(--ink);max-width:none">{diag.intro}</p>
          </div>
          <div class="card" style="padding:28px">
            <div class="eyebrow">Quand le prévoir&nbsp;?</div>
            <ul class="incl mt-3" style="gap:12px">
              {diag.when.map((w) => (
                <li>
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  <span set:html={w} />
                </li>
              ))}
            </ul>
            <p class="muted mt-3" style="font-size:13px">Nous confirmons si ce diagnostic s’applique à votre bien au moment du devis, selon la réglementation en vigueur.</p>
          </div>
        </div>
      )}
    </div>
  </section>

  {diag.diptych && (
    <section class="diptych">
      <figure class="diptych-fig">
        <ResponsiveImage src="/images/mesurage-laser.webp" alt="Mesurage au laser d'une pièce" width={800} height={600} sizes="(max-width: 760px) 92vw, 800px" />
        <figcaption><span class="eyebrow">Sur le terrain</span><span class="diptych-cap">Prise de cote au télémètre</span></figcaption>
      </figure>
      <figure class="diptych-fig">
        <ResponsiveImage src="/images/plan-tablette.webp" alt="Saisie d'un plan sur tablette" width={800} height={600} sizes="(max-width: 760px) 92vw, 800px" />
        <figcaption><span class="eyebrow">Au bureau</span><span class="diptych-cap">Plan numérique sur tablette</span></figcaption>
      </figure>
    </section>
  )}

  <!-- Tarif + inclusion pack -->
  <section class="section-line" id="tarif">
    <div class="wrap" style="max-width:820px">
      <div class="eyebrow">Tarif</div>
      <h2 class="sec-title">{diag.prixVisible}</h2>
      <p class="sec-intro" style="font-size:18px;color:var(--ink)">{diag.prixCond}</p>
      {diag.inPack.length > 0 && (
        <p class="sec-intro mt-2">Ce diagnostic peut être intégré {diag.inPack.map((p, i) => (
          <span>{i > 0 ? ' ou ' : ''}<a href={p === 'vente' ? '/diagnostics-vente' : '/diagnostics-location'}>{p === 'vente' ? 'au pack vente' : 'au pack location'}</a></span>
        ))} lorsque votre bien est concerné ; la composition du pack est confirmée au devis.</p>
      )}
      <div class="flex-cta mt-4">
        <a href="#simulateur" class="btn-blue">Demander mon devis en 2 min</a>
        <a href="/tarifs" class="btn-ghost">Voir les tarifs</a>
      </div>
    </div>
  </section>

  <!-- Doute / pack (cross-sell conversion) — simulateur en 2e instance (#simulateur) -->
  <section class="section-line" id="simulateur">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow center">Votre dossier</div>
        <h2 class="sec-title">Nous vérifions les diagnostics nécessaires à votre bien</h2>
        <p class="sec-intro">Indiquez votre projet et les informations principales du bien&nbsp;: nous confirmons les diagnostics nécessaires avant l'intervention et regroupons le rendez-vous quand c'est possible.</p>
      </div>
      <div class="mt-5"><QuoteForm revealEstimation={true} /></div>
    </div>
  </section>

  <!-- FAQ -->
  <Faq items={diag.faq} title="Questions fréquentes" eyebrow="FAQ" />

  {sources.length > 0 && (
    <section class="section-line">
      <div class="wrap" style="max-width:820px">
        <div class="eyebrow">Sources officielles</div>
        <ul class="sources-list mt-3">
          {sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
        </ul>
        <p class="muted mt-2" style="font-size:13px">Règles générales à replacer dans votre situation ; la composition de votre dossier est confirmée au devis.</p>
      </div>
    </section>
  )}

  <!-- Maillage -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Aller plus loin</div>
      <h2 class="sec-title">Vos diagnostics, en un seul rendez-vous</h2>
      <div class="grid grid-3 mt-5">
        {packLinks.map((o) => (
          <a class="need-card" href={o.url}>
            <h3>{o.nav}</h3>
            <p>{o.navDesc}.</p>
            <span class="go">Dès {prixDes(o.demande)} € TTC
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
        <a class="need-card" href="/diagnostics">
          <h3>Tous les diagnostics</h3>
          <p>Le détail de chaque diagnostic.</p>
          <span class="go">Voir le récapitulatif
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="cta-final">
    <div class="wrap">
      <h2>Une question sur ce diagnostic&nbsp;?</h2>
      <p>Appelez-nous pour préciser la mission, ou décrivez votre bien pour recevoir un devis. {WORDING.engagementDevis}</p>
      <div class="cta">
        <a href="#simulateur" class="btn-gold">Demander mon devis</a>
        <a href={telHref} class="btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.3)">Parler de ce diagnostic</a>
      </div>
    </div>
  </section>
</Base>
