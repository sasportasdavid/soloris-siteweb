---
/**
 * Gabarit des pages locales : /diagnostic-immobilier-{zone}
 * Une seule route dynamique alimentée par ZONES (scalable : ajouter une zone =
 * une entrée dans src/lib/zones.ts). Slugs additifs, aucun slug existant touché.
 * JSON-LD : LocalBusiness (areaServed = zone) + FAQPage + BreadcrumbList.
 * Conformité : aucune promesse de résultat DPE, aucun « pas cher », prix = grille.
 * Textes : dossier éditorial V2 (oct. 2026) — blocs communs + intro/conseil propres à la zone.
 * Statistiques : DPE ENREGISTRÉS (pas tous les logements) ; contexte, jamais une obligation.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ReassuranceBar from '../components/ReassuranceBar.astro';
import OfferCard from '../components/OfferCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import { OFFERS } from '../lib/offers';
import { DPE_FROM, DPE_MAISON_SUPP, prixDes, SURFACE_BANDS } from '../lib/pricing';
import { SITE } from '../lib/site';
import { DPE_FROM_MAX_M2, WORDING } from '../lib/wording';
import { ZONES, type Zone } from '../lib/zones';
import { getZoneStats, fmtPct, fmtInt, fmtSurface, fmtDateFr, listFr, DPE_COLORS } from '../lib/zoneData';
import { localBusinessArea, faqPage, breadcrumb } from '../lib/jsonld';

export function getStaticPaths() {
  return ZONES.map((z) => ({ params: { zone: z.slug }, props: { zone: z } }));
}

interface Props { zone: Zone }
const { zone } = Astro.props;
const url = `/diagnostic-immobilier-${zone.slug}`;
const where = `${zone.prep} ${zone.name}`;

// Chiffres publics de la commune (ADEME, Géorisques) : absents pour les zones sans données.
const stats = getZoneStats(zone.slug);
const nearby = ZONES.filter((z) => z.dept === zone.dept && z.slug !== zone.slug);
const radonLabel: Record<string, string> = {
  '1': 'classe 1 sur 3 (faible)',
  '2': 'classe 2 sur 3 (faible, avec des facteurs géologiques qui peuvent faciliter le transfert vers les bâtiments)',
  '3': 'classe 3 sur 3 (significatif)',
};

const title = `Diagnostic immobilier ${where} | Soloris`;

// FAQ commune du dossier éditorial (identique sur les pages locales).
const faq = [
  {
    q: 'Quel est le prix d’un DPE dans mon secteur ?',
    a: `Le DPE commence à ${DPE_FROM} € TTC pour un appartement jusqu’à ${DPE_FROM_MAX_M2} m². Le tarif varie selon la surface et le type de logement ; une maison comporte un supplément de ${DPE_MAISON_SUPP} € TTC. Le déplacement est inclus dans la zone desservie.`,
  },
  {
    q: 'Quels diagnostics faut-il pour vendre ?',
    a: 'La liste dépend du bien, des dates de construction et de permis, des installations et de la zone. Nous vérifions les diagnostics existants et confirmons le périmètre au devis.',
  },
  {
    q: 'Le déplacement est-il compris ?',
    a: 'Il est inclus à Paris et en Île-de-France pour les prestations prévues au devis.',
  },
  {
    q: 'Comment fixer le rendez-vous ?',
    a: `Décrivez votre projet dans le formulaire. Nous confirmons le prix et les disponibilités avec vous pendant nos horaires d’ouverture, ${SITE.rappel.horaires.replace(', de ', ' de ')}.`,
  },
];

const jsonLd = [
  localBusinessArea(zone.name),
  faqPage(faq),
  breadcrumb([
    { name: 'Accueil', url: '/' },
    { name: `Diagnostic immobilier ${where}`, url },
  ]),
];
---
<Base title={title} description={zone.metaDesc} path={url} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a> <span>/</span> <span aria-current="page">Diagnostic immobilier {where}</span>
    </nav>
  </div>

  <Hero
    tagpill={`${zone.dept} · Diagnostiqueur certifié`}
    h1={`Vos diagnostics immobiliers ${where}`}
    sub={`DPE, vente ou location : préparez votre intervention ${where}, avec un prix annoncé avant la visite.`}
    showTrust={true}
    sun={true}
    hideCta={true}
    aside={true}
  >
    <Fragment slot="aside">
      <QuoteForm revealEstimation={true} />
    </Fragment>
  </Hero>

  <ReassuranceBar />

  <!-- Contexte local (unique par zone) -->
  <section class="section-line">
    <div class="wrap" style="max-width:820px">
      <div class="eyebrow">Votre secteur</div>
      <h2 class="sec-title">Vos diagnostics {where}</h2>
      <p class="sec-intro" style="font-size:18px;color:var(--ink);max-width:none">{zone.intro}</p>
      <div class="zconseil mt-3">
        <strong>À préparer avant la visite</strong>
        <p>{zone.conseil}</p>
      </div>
      <p class="muted mt-2" style="font-size:14.5px">Codes postaux desservis : {zone.postalCodes.join(', ')} · et toute l'Île-de-France.</p>
    </div>
  </section>

  {stats && (
    <section class="section-line" id="chiffres">
      <div class="wrap">
        <div class="eyebrow">Données publiques</div>
        <h2 class="sec-title">Les logements décrits dans les DPE enregistrés {where}</h2>
        <p class="sec-intro">Sur {fmtInt(stats.dpeTotal)} DPE enregistrés {where} depuis juillet 2021, l'étiquette la plus fréquente est la {stats.topEtiquette.label} ({fmtPct(stats.topEtiquette.pct)}) et l'époque de construction la plus représentée, {stats.topPeriode.label.toLowerCase()} ({fmtPct(stats.topPeriode.pct)}).</p>
        <p class="sec-intro mt-2">Ces chiffres portent sur les DPE présents dans le jeu de données cité, et non sur tous les logements de la commune. Un même logement peut apparaître plusieurs fois. Les périodes de collecte et les évolutions de méthode doivent être prises en compte pour interpréter les résultats.</p>

        <div class="grid grid-3 mt-5">
          <div class="card zcard">
            <h3>Étiquettes DPE</h3>
            <ul class="zbars" aria-label={`Répartition des étiquettes DPE ${where}`}>
              {stats.etiquettes.map((e) => (
                <li>
                  <span class="zl">{e.label}</span>
                  <span class="zbar" aria-hidden="true"><i style={`width:${Math.max(e.pct, 1.5)}%;background:${DPE_COLORS[e.label]}`}></i></span>
                  <span class="zv">{fmtPct(e.pct)}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="card zcard">
            <h3>Époque de construction</h3>
            <ul class="zbars" aria-label={`Répartition par époque de construction ${where}`}>
              {stats.periodes.map((p) => (
                <li class="wide">
                  <span class="zl">{p.label}</span>
                  <span class="zbar" aria-hidden="true"><i style={`width:${Math.max(p.pct, 1.5)}%;background:var(--blue)`}></i></span>
                  <span class="zv">{fmtPct(p.pct)}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="card zcard">
            <h3>Appartements et maisons</h3>
            <p class="zbig"><strong>{fmtPct(stats.shareAppartement)}</strong> d'appartements</p>
            <p class="zbig"><strong>{fmtPct(stats.shareMaison)}</strong> de maisons</p>
            <p class="muted" style="font-size:14px;margin-top:10px">
              {stats.surfaceAppartement != null && <>Surface moyenne d'un appartement : {fmtSurface(stats.surfaceAppartement)}.</>}
              {stats.surfaceMaison != null && stats.nMaison >= 150 && <> Pour une maison : {fmtSurface(stats.surfaceMaison)}.</>}
            </p>
          </div>
        </div>

        <div class="zlist mt-5">
          <h3>Comment lire ces données pour votre bien {where}</h3>
          <p class="muted" style="font-size:14.5px;margin:0 0 10px">Ces données donnent un contexte. Elles ne déterminent ni la classe de votre logement ni la liste de vos diagnostics obligatoires. Seules les informations du bien et le périmètre applicable permettent de préparer votre dossier.</p>
          <ul>
            <li>
              <strong>Plomb et amiante.</strong> {fmtPct(stats.shareAvant1948)} des logements décrits dans ces DPE datent d'avant 1948 et au moins {fmtPct(stats.sharePre1989)} d'avant 1989.
              Pour votre bien, le CREP dépend de sa date de construction (avant le 1er janvier 1949) et le constat amiante de la date de son permis de construire (avant le 1er juillet 1997).
            </li>
            <li>
              <strong>Classes F et G.</strong> {fmtPct(stats.shareFG)} des DPE enregistrés {where} sont classés F ou G. En métropole, les critères de performance énergétique pour la location concernent la classe G depuis 2025, puis F en 2028, selon les modalités applicables aux baux
              (<a href="/guides/reforme-dpe">les réformes du DPE</a>). Les étiquettes établies avant 2026 reposent sur l'ancien coefficient de conversion de l'électricité (2,3, contre 1,9 depuis le 1er janvier 2026).
            </li>
            <li>
              <strong>État des risques.</strong> Il est établi pour l'adresse exacte du bien, pas à partir d'une moyenne communale.
              {stats.risques.length > 0 ? <> {where.charAt(0).toUpperCase() + where.slice(1)}, Géorisques recense au niveau de la commune : {listFr(stats.risques)}.</> : <> {where.charAt(0).toUpperCase() + where.slice(1)}, Géorisques ne recense pas de risque majeur de premier niveau au niveau de la commune.</>}
              {stats.radonClasse && <> Potentiel radon : {radonLabel[stats.radonClasse] || `classe ${stats.radonClasse}`}.</>}
              {stats.sismicite && <> Zone de sismicité : {stats.sismicite}.</>}
              {stats.catnat.total > 0 && <> {stats.catnat.total} arrêtés de catastrophe naturelle sont recensés depuis {stats.catnat.depuis}{stats.catnat.principal ? <>, principalement pour « {stats.catnat.principal.toLowerCase()} »</> : null}.</>}
            </li>
            <li>
              <strong>Tarif.</strong> Le prix d'un DPE dépend de la surface du logement et du type de bien : retrouvez la grille sur la page <a href="/tarifs">tarifs</a>.
            </li>
          </ul>
        </div>

        <p class="muted mt-3" style="font-size:13px;max-width:none">
          Sources : ADEME (Observatoire DPE-Audit, DPE des logements existants établis depuis juillet 2021), Géorisques (BRGM), Etalab. Données extraites le {fmtDateFr(stats.generatedAt)}.
          Les chiffres portent sur les DPE enregistrés, qui ne couvrent pas l'ensemble des logements de la commune.
        </p>
      </div>
    </section>
  )}

  <!-- Nos prestations -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Nos prestations</div>
      <h2 class="sec-title">Choisissez les diagnostics adaptés à votre projet</h2>
      <p class="sec-intro">DPE seul, pack vente ou pack location : nous précisons les prestations nécessaires selon votre bien. Un audit énergétique, lorsqu’il est requis, fait l’objet d’une mission distincte.</p>
      <div class="grid grid-4 mt-5">
        {OFFERS.map((o) => <OfferCard offer={o} />)}
      </div>
    </div>
  </section>

  <!-- Tarifs + simulateur (2e instance du QuoteForm, ancre #simulateur) -->
  <section class="section-line" id="tarifs">
    <div class="wrap">
      <div class="eyebrow">Tarifs</div>
      <h2 class="sec-title">Un prix annoncé avant l’intervention</h2>
      <p class="sec-intro">DPE dès {DPE_FROM}&nbsp;€ TTC pour un appartement jusqu’à {DPE_FROM_MAX_M2}&nbsp;m². Packs vente et location dès {prixDes('vente')}&nbsp;€ TTC pour un appartement de {SURFACE_BANDS[0].maxIncl}&nbsp;m² maximum construit depuis moins de 15 ans. Prix selon le bien, déplacement inclus ; devis confirmé avant la visite.</p>
      <div class="mt-5" id="simulateur"><QuoteForm revealEstimation={true} /></div>
    </div>
  </section>

  <!-- Avis -->
  <Reviews limit={3} />

  <!-- Déroulement -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Déroulement</div>
      <h2 class="sec-title">Une visite organisée avec vous</h2>
      <p class="sec-intro">Nous confirmons les disponibilités et les documents utiles à la préparation de votre intervention. Les rapports de diagnostics sont généralement remis sous 24&nbsp;h après la visite, selon le dossier. Le délai d’un audit énergétique est confirmé au devis.</p>
      <div class="grid grid-3 mt-5 steps">
        <div class="step"><div class="n">Étape 1</div><h3>Votre demande</h3><p>Décrivez votre projet et votre bien. Votre demande de devis prend environ 2&nbsp;minutes.</p></div>
        <div class="step"><div class="n">Étape 2</div><h3>Confirmation</h3><p>Nous confirmons les prestations, le prix et le créneau d’intervention {where}.</p></div>
        <div class="step"><div class="n">Étape 3</div><h3>Diagnostics et rapports</h3><p>Le professionnel réalise les diagnostics et vous transmet les rapports avec les explications utiles.</p></div>
      </div>
    </div>
  </section>

  <!-- FAQ locale -->
  <Faq items={faq} title={`Questions fréquentes ${where}`} eyebrow="FAQ" />

  <!-- Maillage interne : autres secteurs du même département + page hub -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Autour de {zone.name}</div>
      <h2 class="sec-title" style="font-size:26px">Nos autres secteurs : {zone.dept}</h2>
      <ul class="zchips">
        {nearby.map((z) => <li><a href={`/diagnostic-immobilier-${z.slug}`}>{z.name}</a></li>)}
        <li><a href="/zones-desservies" class="all">Toutes les zones desservies</a></li>
      </ul>
    </div>
  </section>

  <!-- CTA final -->
  <section class="cta-final">
    <div class="wrap">
      <h2>Vos diagnostics {where}</h2>
      <p>{WORDING.engagementDevis}</p>
      <div class="cta">
        <a href="#simulateur" class="btn-gold">Demander mon devis</a>
        <a href="/tarifs" class="btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.3)">Voir les tarifs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .zcard { padding: 22px 24px; }
  .zconseil { background: var(--paper); border: 1px solid var(--line); border-left: 3px solid var(--gold); border-radius: 12px; padding: 14px 18px; }
  .zconseil strong { font-family: var(--sora); color: var(--blue); font-size: 15px; }
  .zconseil p { margin: 4px 0 0; font-size: 15px; color: var(--ink); }
  .zcard h3 { font-family: var(--sora); font-size: 16px; color: var(--blue); margin: 0 0 12px; }
  .zbars { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .zbars li { display: grid; grid-template-columns: 22px 1fr 52px; align-items: center; gap: 8px; font-size: 14px; }
  .zbars li.wide { grid-template-columns: 96px 1fr 52px; }
  .zl { font-weight: 600; color: var(--ink); }
  .zbar { display: block; height: 10px; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .zbar i { display: block; height: 100%; border-radius: 6px; }
  .zv { text-align: right; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .zbig { margin: 4px 0; font-size: 16px; color: var(--ink); }
  .zbig strong { font-family: var(--sora); font-size: 26px; color: var(--blue); }
  .zlist h3 { font-family: var(--sora); font-size: 19px; color: var(--blue); margin: 0 0 10px; }
  .zlist ul { margin: 0; padding-left: 20px; display: grid; gap: 10px; line-height: 1.6; }
  .zchips { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .zchips a { display: inline-block; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--blue); text-decoration: none; font-size: 14.5px; }
  .zchips a:hover { border-color: var(--blue); }
  .zchips a.all { background: var(--paper); font-weight: 600; }
</style>
