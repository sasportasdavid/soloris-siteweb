---
/**
 * Gabarit des pages locales : /diagnostic-immobilier-{zone}
 * Une seule route dynamique alimentée par ZONES (scalable : ajouter une zone =
 * une entrée dans src/lib/zones.ts). Slugs additifs, aucun slug existant touché.
 * JSON-LD : LocalBusiness (areaServed = zone) + FAQPage + BreadcrumbList.
 * Conformité : aucune promesse de résultat DPE, aucun « pas cher », prix = grille.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ReassuranceBar from '../components/ReassuranceBar.astro';
import OfferCard from '../components/OfferCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import { OFFERS } from '../lib/offers';
import { prixDes } from '../lib/pricing';
import { ZONES, type Zone } from '../lib/zones';
import { getZoneStats, fmtPct, fmtInt, fmtSurface, fmtDateFr, listFr, DPE_COLORS } from '../lib/zoneData';
import { localBusinessArea, faqPage, breadcrumb } from '../lib/jsonld';

export function getStaticPaths() {
  return ZONES.map((z) => ({ params: { zone: z.slug }, props: { zone: z } }));
}

interface Props { zone: Zone }
const { zone } = Astro.props;
const url = `/diagnostic-immobilier-${zone.slug}`;
const where = `${zone.prep} ${zone.name}`;

// Chiffres publics de la commune (ADEME, Géorisques) : absents pour les zones sans données.
const stats = getZoneStats(zone.slug);
const nearby = ZONES.filter((z) => z.dept === zone.dept && z.slug !== zone.slug);
const radonLabel: Record<string, string> = {
  '1': 'classe 1 sur 3 (faible)',
  '2': 'classe 2 sur 3 (faible, avec des facteurs géologiques qui peuvent faciliter le transfert vers les bâtiments)',
  '3': 'classe 3 sur 3 (significatif)',
};

const title = `Diagnostic immobilier ${where} | Soloris`;

const faq = [
  {
    q: `Intervenez-vous ${where} ?`,
    a: `Oui. Soloris réalise vos diagnostics immobiliers ${where} (${zone.dept}) et dans toute l'Île-de-France, avec un rendez-vous sous 48 h et un rapport remis sous 24 h après la visite, dans la plupart des cas.`,
  },
  {
    q: `Combien coûte un DPE ${where} ?`,
    a: `Un DPE est tout compris dès ${prixDes('dpe')} €, déplacement inclus, le prix variant selon la surface du logement. Vous obtenez une estimation immédiate via notre formulaire de devis.`,
  },
  {
    q: `Quels diagnostics sont nécessaires pour vendre ${where} ?`,
    a: `Selon le bien : DPE et ERP, complétés par l'amiante, le plomb, l'électricité, le gaz, le mesurage Loi Carrez et, en zone concernée, les termites. Nous établissons la liste applicable à votre logement au moment du devis.`,
  },
  {
    q: `Quels sont vos délais ${where} ?`,
    a: `Nous proposons un rendez-vous sous 48 h et la remise du rapport sous 24 h après la visite, dans la plupart des cas ${where} et en Île-de-France.`,
  },
];

if (stats) {
  faq.push({
    q: `Quels diagnostics pour un logement ancien ${where} ?`,
    a: `${fmtPct(stats.shareAvant1948)} des logements ayant fait l'objet d'un DPE ${where} datent d'avant 1948 : le diagnostic plomb (CREP) est alors requis, ainsi que l'amiante pour les permis de construire antérieurs au 1er juillet 1997. Nous établissons la liste exacte applicable à votre bien au moment du devis.`,
  });
}

const jsonLd = [
  localBusinessArea(zone.name),
  faqPage(faq),
  breadcrumb([
    { name: 'Accueil', url: '/' },
    { name: `Diagnostic immobilier ${where}`, url },
  ]),
];
---
<Base title={title} description={zone.metaDesc} path={url} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a> <span>/</span> <span aria-current="page">Diagnostic immobilier {where}</span>
    </nav>
  </div>

  <Hero
    tagpill={`${zone.dept} · Certifié COFRAC`}
    h1={`Diagnostic immobilier ${where}, <span class="hl">rapport sous 24 h</span>`}
    sub={`DPE, vente, location, audit : tarif tout compris, déplacement inclus. Soloris intervient ${where} et en Île-de-France.`}
    showTrust={true}
    sun={true}
    hideCta={true}
    aside={true}
  >
    <Fragment slot="aside">
      <QuoteForm revealEstimation={true} />
    </Fragment>
  </Hero>

  <ReassuranceBar />

  <!-- Contexte local (unique par zone) -->
  <section class="section-line">
    <div class="wrap" style="max-width:820px">
      <div class="eyebrow">Votre secteur</div>
      <h2 class="sec-title">Vos diagnostics {where}</h2>
      <p class="sec-intro" style="font-size:18px;color:var(--ink);max-width:none">{zone.intro}</p>
      <p class="muted mt-2" style="font-size:14.5px">Codes postaux desservis : {zone.postalCodes.join(', ')} · et toute l'Île-de-France.</p>
    </div>
  </section>

  {stats && (
    <section class="section-line" id="chiffres">
      <div class="wrap">
        <div class="eyebrow">Données publiques</div>
        <h2 class="sec-title">Le parc immobilier {where} en chiffres</h2>
        <p class="sec-intro">Sur {fmtInt(stats.dpeTotal)} DPE enregistrés {where} depuis juillet 2021, l'étiquette la plus fréquente est la {stats.topEtiquette.label} ({fmtPct(stats.topEtiquette.pct)}) et l'époque de construction dominante, {stats.topPeriode.label.toLowerCase()} ({fmtPct(stats.topPeriode.pct)}). Voici ce que cela change pour vos diagnostics.</p>

        <div class="grid grid-3 mt-5">
          <div class="card zcard">
            <h3>Étiquettes DPE</h3>
            <ul class="zbars" aria-label={`Répartition des étiquettes DPE ${where}`}>
              {stats.etiquettes.map((e) => (
                <li>
                  <span class="zl">{e.label}</span>
                  <span class="zbar" aria-hidden="true"><i style={`width:${Math.max(e.pct, 1.5)}%;background:${DPE_COLORS[e.label]}`}></i></span>
                  <span class="zv">{fmtPct(e.pct)}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="card zcard">
            <h3>Époque de construction</h3>
            <ul class="zbars" aria-label={`Répartition par époque de construction ${where}`}>
              {stats.periodes.map((p) => (
                <li class="wide">
                  <span class="zl">{p.label}</span>
                  <span class="zbar" aria-hidden="true"><i style={`width:${Math.max(p.pct, 1.5)}%;background:var(--blue)`}></i></span>
                  <span class="zv">{fmtPct(p.pct)}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="card zcard">
            <h3>Appartements et maisons</h3>
            <p class="zbig"><strong>{fmtPct(stats.shareAppartement)}</strong> d'appartements</p>
            <p class="zbig"><strong>{fmtPct(stats.shareMaison)}</strong> de maisons</p>
            <p class="muted" style="font-size:14px;margin-top:10px">
              {stats.surfaceAppartement != null && <>Surface moyenne d'un appartement : {fmtSurface(stats.surfaceAppartement)}.</>}
              {stats.surfaceMaison != null && stats.nMaison >= 150 && <> Pour une maison : {fmtSurface(stats.surfaceMaison)}.</>}
            </p>
          </div>
        </div>

        <div class="zlist mt-5">
          <h3>Ce que cela change pour vos diagnostics {where}</h3>
          <ul>
            <li>
              <strong>Plomb et amiante.</strong> {fmtPct(stats.shareAvant1948)} des logements datent d'avant 1948 : le diagnostic plomb (CREP) concerne les logements construits avant 1949.
              Au moins {fmtPct(stats.sharePre1989)} ont été construits avant 1989 : tous les logements dont le permis de construire date d'avant le 1er juillet 1997 entrent dans le champ du diagnostic amiante.
            </li>
            <li>
              <strong>Passoires thermiques.</strong> {fmtPct(stats.shareFG)} des DPE {where} sont classés F ou G. Un logement classé G ne peut plus être loué depuis le 1er janvier 2025, et la classe F le sera à partir du 1er janvier 2028
              (<a href="/guides/reforme-dpe">détail de la réforme du DPE</a>). Les étiquettes établies avant 2026 reposent sur l'ancien coefficient de conversion de l'électricité : certains logements ont pu gagner une classe depuis.
            </li>
            <li>
              <strong>Risques (ERP).</strong> L'état des risques et pollutions, obligatoire dans un dossier de vente ou de location, est établi pour l'adresse exacte du bien.
              {stats.risques.length > 0 ? <> {where.charAt(0).toUpperCase() + where.slice(1)}, Géorisques recense au niveau de la commune : {listFr(stats.risques)}.</> : <> {where.charAt(0).toUpperCase() + where.slice(1)}, Géorisques ne recense pas de risque majeur de premier niveau au niveau de la commune.</>}
              {stats.radonClasse && <> Potentiel radon : {radonLabel[stats.radonClasse] || `classe ${stats.radonClasse}`}.</>}
              {stats.sismicite && <> Zone de sismicité : {stats.sismicite}.</>}
              {stats.catnat.total > 0 && <> {stats.catnat.total} arrêtés de catastrophe naturelle sont recensés depuis {stats.catnat.depuis}{stats.catnat.principal ? <>, principalement pour « {stats.catnat.principal.toLowerCase()} »</> : null}.</>}
            </li>
            <li>
              <strong>Tarif.</strong> Le prix d'un DPE dépend de la surface du logement et du type de bien : retrouvez la grille sur la page <a href="/tarifs">tarifs</a>.
            </li>
          </ul>
        </div>

        <p class="muted mt-3" style="font-size:13px;max-width:none">
          Sources : ADEME (Observatoire DPE-Audit, DPE des logements existants établis depuis juillet 2021), Géorisques (BRGM), Etalab. Données extraites le {fmtDateFr(stats.generatedAt)}.
          Les chiffres portent sur les DPE enregistrés, qui ne couvrent pas l'ensemble des logements de la commune.
        </p>
      </div>
    </section>
  )}

  <!-- Nos prestations -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Nos prestations</div>
      <h2 class="sec-title">Quel diagnostic vous faut-il {where}&nbsp;?</h2>
      <div class="grid grid-4 mt-5">
        {OFFERS.map((o) => <OfferCard offer={o} />)}
      </div>
    </div>
  </section>

  <!-- Tarifs + simulateur (2e instance du QuoteForm, ancre #simulateur) -->
  <section class="section-line" id="tarifs">
    <div class="wrap">
      <div class="eyebrow">Tarif tout compris</div>
      <h2 class="sec-title">Combien ça coûte {where}&nbsp;?</h2>
      <p class="sec-intro">Mêmes tarifs qu'à Paris et en Île-de-France : tout compris, déplacement inclus. Dès {prixDes('dpe')} € pour un DPE, dès {prixDes('vente')} € pour un pack vente. Estimez le vôtre en 2 min, sans engagement.</p>
      <div class="mt-5" id="simulateur"><QuoteForm revealEstimation={true} /></div>
    </div>
  </section>

  <!-- Avis -->
  <Reviews limit={3} title="Ils nous ont fait confiance" eyebrow="Avis vérifiés" />

  <!-- Process : RDV sous 48 h, rapport sous 24 h -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Notre process</div>
      <h2 class="sec-title">Rendez-vous rapide, rapport sous 24&nbsp;h</h2>
      <div class="grid grid-3 mt-5 steps">
        <div class="step"><div class="n">Étape 1</div><h3>Devis immédiat</h3><p>Estimation tout compris en 2 minutes, en ligne.</p></div>
        <div class="step"><div class="n">Étape 2</div><h3>Rendez-vous sous 48 h</h3><p>Un diagnostiqueur certifié intervient {where}.</p></div>
        <div class="step"><div class="n">Étape 3</div><h3>Rapport sous 24 h</h3><p>Document clair et opposable, remis sous 24 h après la visite.</p></div>
      </div>
    </div>
  </section>

  <!-- FAQ locale -->
  <Faq items={faq} title={`Questions fréquentes ${where}`} eyebrow="FAQ" />

  <!-- Maillage interne : autres secteurs du même département + page hub -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Autour de {zone.name}</div>
      <h2 class="sec-title" style="font-size:26px">Nos autres secteurs : {zone.dept}</h2>
      <ul class="zchips">
        {nearby.map((z) => <li><a href={`/diagnostic-immobilier-${z.slug}`}>{z.name}</a></li>)}
        <li><a href="/zones-desservies" class="all">Toutes les zones desservies</a></li>
      </ul>
    </div>
  </section>

  <!-- CTA final -->
  <section class="cta-final">
    <div class="wrap">
      <h2>Vos diagnostics {where}, en toute clarté</h2>
      <p>Estimation tout compris en 2 minutes, sans engagement.</p>
      <div class="cta">
        <a href="#simulateur" class="btn-gold">Obtenir mon devis</a>
        <a href="/tarifs" class="btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.3)">Voir les tarifs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .zcard { padding: 22px 24px; }
  .zcard h3 { font-family: var(--sora); font-size: 16px; color: var(--blue); margin: 0 0 12px; }
  .zbars { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .zbars li { display: grid; grid-template-columns: 22px 1fr 52px; align-items: center; gap: 8px; font-size: 14px; }
  .zbars li.wide { grid-template-columns: 96px 1fr 52px; }
  .zl { font-weight: 600; color: var(--ink); }
  .zbar { display: block; height: 10px; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .zbar i { display: block; height: 100%; border-radius: 6px; }
  .zv { text-align: right; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .zbig { margin: 4px 0; font-size: 16px; color: var(--ink); }
  .zbig strong { font-family: var(--sora); font-size: 26px; color: var(--blue); }
  .zlist h3 { font-family: var(--sora); font-size: 19px; color: var(--blue); margin: 0 0 10px; }
  .zlist ul { margin: 0; padding-left: 20px; display: grid; gap: 10px; line-height: 1.6; }
  .zchips { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .zchips a { display: inline-block; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--blue); text-decoration: none; font-size: 14.5px; }
  .zchips a:hover { border-color: var(--blue); }
  .zchips a.all { background: var(--paper); font-weight: 600; }
</style>
