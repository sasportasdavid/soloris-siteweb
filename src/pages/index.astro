---
/**
 * Accueil — hub + conversion. Textes : dossier éditorial V2 (oct. 2026).
 * Hero dynamique (landing DTR). JSON-LD : LocalBusiness + FAQPage.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ReassuranceBar from '../components/ReassuranceBar.astro';
import OfferCard from '../components/OfferCard.astro';
import ReportPreview from '../components/ReportPreview.astro';
import EnergyScale from '../components/EnergyScale.astro';
import Reviews from '../components/Reviews.astro';
import ReviewWall from '../components/ReviewWall.astro';
import CallbackForm from '../components/CallbackForm.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import Faq from '../components/Faq.astro';
import { OFFERS } from '../lib/offers';
import { DPE_FROM, prixDes } from '../lib/pricing';
import { SITE } from '../lib/site';
import { CONDITIONS, WORDING } from '../lib/wording';
import { localBusiness, faqPage } from '../lib/jsonld';

const piliers = [
  { t: 'Un prix annoncé', d: 'Vous connaissez le montant avant la visite.', ic: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
  { t: 'Une intervention préparée', d: 'Nous précisons les accès et documents nécessaires.', ic: '<path d="M13 2 3 14h7l-1 8 10-12h-7z"/>' },
  { t: 'Un professionnel certifié', d: 'Les diagnostics soumis à certification sont réalisés dans les domaines concernés.', ic: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>' },
  { t: 'Des résultats expliqués', d: 'Vous comprenez les constats et les prochaines démarches.', ic: '<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>' },
];

const faq = [
  { q: 'Comment connaître les diagnostics nécessaires ?', a: 'Ils dépendent notamment du projet, du bien, des installations et de sa localisation. Nous vérifions la composition de votre dossier avant de confirmer le devis.' },
  { q: 'Le DPE suffit-il pour vendre ou louer ?', a: 'Pas toujours. Des diagnostics complémentaires peuvent être nécessaires selon le logement. Le pack est adapté à cette situation ; le DPE seul reste une prestation distincte.' },
  { q: 'Le prix affiché est-il définitif ?', a: 'Le prix « dès » est un prix d’entrée. L’estimation dépend des informations renseignées ; le devis est confirmé avant l’intervention.' },
  { q: 'Quand serai-je recontacté ?', a: WORDING.rappelValide },
  { q: 'Garantissez-vous une meilleure note DPE ?', a: 'Non. La classe résulte de l’évaluation réglementaire du logement. Notre engagement porte sur la réalisation du diagnostic et l’explication des résultats.' },
];

const jsonLd = [localBusiness(), faqPage(faq)];
const title = 'Diagnostic immobilier Paris et Île-de-France | Soloris';
const description = 'DPE, diagnostics vente et location, audit énergétique à Paris et en Île-de-France. Prix annoncé avant la visite, déplacement inclus.';
---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- 2 · Hero dynamique — simulateur de devis embarqué (composant unique QuoteForm) -->
  <Hero
    dynamic={true}
    h1='Diagnostics immobiliers à <span class="hl">Paris et en Île-de-France</span>'
    sub="Vente, location, DPE ou audit énergétique : les diagnostics adaptés à votre bien, un prix annoncé avant la visite et une démarche simple."
    showTrust={true}
    sun={true}
    hideCta={true}
    aside={true}
  >
    <Fragment slot="aside">
      <QuoteForm revealEstimation={true} />
    </Fragment>
  </Hero>

  <!-- 3 · Barre de réassurance -->
  <ReassuranceBar />

  <!-- 3 · Quel est votre besoin ? -->
  <section class="section-line">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow center">Par où commencer</div>
        <h2 class="sec-title">Quel est votre projet&nbsp;?</h2>
        <p class="sec-intro">Vous vendez, vous louez ou vous avez besoin d’un DPE ? Retrouvez l’offre adaptée à votre situation. Nous vous aidons à préciser les diagnostics nécessaires.</p>
      </div>
      <div class="grid grid-4 mt-5">
        {OFFERS.map((o) => <OfferCard offer={o} />)}
      </div>
    </div>
  </section>

  <!-- 4 · Capture express « Être rappelé » (téléphone + code postal, friction minimale) -->
  <section class="section-line" id="rappel">
    <div class="wrap">
      <div class="grid grid-2" style="align-items:center;gap:40px">
        <div>
          <div class="eyebrow">Être rappelé</div>
          <h2 class="sec-title">Vous préférez échanger avec nous&nbsp;?</h2>
          <p class="sec-intro">Laissez votre numéro et le code postal du bien. Nous vous rappelons sous {SITE.rappel.delai}, {SITE.rappel.horaires}, pour préciser votre besoin et organiser la suite. {WORDING.horsHoraires}</p>
        </div>
        <CallbackForm />
      </div>
    </div>
  </section>

  <!-- 5 · Comment ça marche -->
  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Comment ça marche</div>
      <h2 class="sec-title">Vos diagnostics en trois étapes</h2>
      <div class="grid grid-3 mt-5 steps">
        <div class="step">
          <div class="step-media step-media--price">
            <span class="step-n">Étape 1</span>
            <div class="step-price"><strong>2 min</strong><span>pour votre demande</span></div>
          </div>
          <div class="step-body"><h3>Votre demande</h3><p>Décrivez votre projet et votre bien. Votre demande de devis prend environ 2 minutes.</p></div>
        </div>
        <div class="step">
          <div class="step-media">
            <span class="step-n">Étape 2</span>
            <ResponsiveImage src="/images/mesure-tablette.webp" alt="Rendez-vous avec un diagnostiqueur certifié" width={520} height={358} />
          </div>
          <div class="step-body"><h3>Confirmation</h3><p>Nous confirmons les prestations, le prix et le créneau d’intervention.</p></div>
        </div>
        <div class="step">
          <div class="step-media">
            <span class="step-n">Étape 3</span>
            <ResponsiveImage src="/images/rapport-famille.webp" alt="Remise d'un rapport de diagnostic clair" width={520} height={358} />
          </div>
          <div class="step-body"><h3>Diagnostics et rapports</h3><p>Le professionnel réalise les diagnostics et vous transmet les rapports avec les explications utiles.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · Nos engagements — 4 garanties (cartes numérotées 2×2) -->
  <section class="section-line">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow center">Nos engagements</div>
        <h2 class="sec-title">Des engagements concrets</h2>
      </div>
      <div class="grid grid-2 mt-5 engage">
        {piliers.map((p, i) => (
          <div class="eng-card">
            <span class="eng-num" aria-hidden="true">{i + 1}</span>
            <div class="eng-body">
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 · Tarifs en aperçu -->
  <section class="section-line">
    <div class="wrap">
      <div class="block-blue">
        <div class="kicker">Tarifs</div>
        <h2>Un tarif clair, dès le départ</h2>
        <p>DPE dès {DPE_FROM}&nbsp;€ TTC. Packs vente et location dès {prixDes('vente')}&nbsp;€ TTC. Déplacement inclus à Paris et en Île-de-France. Le prix de votre intervention est confirmé au devis.</p>
        <p class="price-cond">DPE : {CONDITIONS.dpe}<br />Packs : {CONDITIONS.pack}</p>
        <div class="flex-cta mt-3">
          <a href="/tarifs" class="btn-gold">Voir les tarifs</a>
          <a href="/devis" class="btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.3)">Demander mon devis</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 · Expertise énergie / réforme DPE -->
  <section class="section-line">
    <div class="wrap">
      <div class="split-media">
        <div class="split-media-img">
          <ResponsiveImage src="/images/camera-thermique.webp" alt="Diagnostiqueuse réalisant un relevé à la caméra thermique" width={620} height={720} sizes="(max-width: 760px) 92vw, 620px" />
        </div>
        <div class="split-media-body">
          <div class="eyebrow">Énergie</div>
          <h2 class="sec-title">DPE ou audit énergétique : deux besoins différents</h2>
          <p class="sec-intro">
            Le DPE évalue la performance énergétique du logement. L’audit énergétique étudie des scénarios
            de travaux. Nous vous aidons à identifier la prestation adaptée à votre projet, sans promettre
            une classe énergétique.
          </p>
          <p class="muted mt-2" style="font-size:13.5px">Étiquette ci-dessous : {WORDING.illustration}</p>
          <div class="escale-compact mt-3">
            <EnergyScale highlight="C" />
          </div>
          <div class="flex-cta mt-3">
            <a href="/audit-energetique" class="btn-blue">L'audit énergétique</a>
            <a href="/guides/reforme-dpe" class="btn-ghost">Les évolutions du DPE</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 9 · Aperçu d'un rapport type -->
  <section class="section-line" id="rapport-type">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow center">À quoi ressemble votre rapport ?</div>
        <h2 class="sec-title">Des rapports pour avancer dans votre projet</h2>
        <p class="sec-intro">Retrouvez les résultats des diagnostics réalisés et les informations utiles pour votre vente, votre location ou votre réflexion sur les travaux. Exemple de présentation à titre illustratif.</p>
      </div>
      <div class="mt-5" style="max-width:880px;margin-left:auto;margin-right:auto">
        <ReportPreview />
      </div>
    </div>
  </section>

  <!-- 10 · Avis clients -->
  <Reviews limit={3} />

  <!-- 10b · Wall of love — 2e bloc de preuve sociale (volume d'avis réels) -->
  <ReviewWall />

  <!-- 10c · Bandeau terrain Paris & Île-de-France -->
  <section class="geo-band">
    <div class="wrap">
      <div class="eyebrow center">Zone d’intervention</div>
      <h2>Votre bien se situe en Île-de-France&nbsp;?</h2>
      <p>Nous intervenons à Paris et dans les départements 77, 78, 91, 92, 93, 94 et 95. Consultez les <a href="/zones-desservies" style="color:inherit;text-decoration:underline">secteurs desservis</a> ou indiquez le code postal du bien dans votre demande.</p>
      <a href="/devis" class="btn-gold">Demander mon devis</a>
    </div>
  </section>

  <!-- 11 · FAQ -->
  <Faq items={faq} title="Questions fréquentes" />

  <!-- 12 · CTA final -->
  <section class="cta-final cta-final--split">
    <div class="wrap cta-final-grid">
      <div class="cta-final-copy">
        <h2>Préparez votre intervention</h2>
        <p>Décrivez votre bien. Nous revenons vers vous pour confirmer votre devis et les disponibilités. {WORDING.engagementDevis}</p>
        <div class="cta">
          <a href="/devis" class="btn-gold">Demander mon devis</a>
          <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.3)">Appeler Soloris</a>
        </div>
      </div>
      <div class="cta-final-media">
        <ResponsiveImage src="/images/remise-cles.webp" alt="Remise des clés d'un appartement" width={640} height={520} sizes="(max-width: 760px) 92vw, 640px" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Nos engagements — cartes numérotées 2×2 (registre institutionnel) */
  .engage { gap: 22px; }
  .eng-card {
    display: flex; gap: 18px;
    background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 28px;
    transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .eng-card:hover { border-color: var(--line-strong); box-shadow: var(--shadow-card); transform: translateY(-2px); }
  .eng-num {
    flex: none; width: 44px; height: 44px; border-radius: 10px;
    background: var(--blue); color: var(--amber);
    font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 23px;
    display: flex; align-items: center; justify-content: center; line-height: 1;
  }
  .eng-body h3 { font-family: var(--sora); font-weight: 600; font-size: 19px; color: var(--blue); margin-bottom: 6px; }
  .eng-body p { font-size: 14.5px; color: var(--ink-soft); }
  .price-cond { font-size: 13.5px; opacity: .85; margin-top: 10px; line-height: 1.6; }
  @media (max-width: 720px) { .eng-card { padding: 22px; } }
</style>
