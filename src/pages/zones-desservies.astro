---
/**
 * /zones-desservies : page hub de toutes les pages locales (maillage interne).
 * Alimentée par ZONES : une zone ajoutée dans src/lib/zones.ts apparaît ici automatiquement.
 */
import Base from '../layouts/Base.astro';
import ReassuranceBar from '../components/ReassuranceBar.astro';
import { ZONES } from '../lib/zones';
import { breadcrumb } from '../lib/jsonld';

// Regroupement par département, dans un ordre stable (Paris d'abord).
const ORDER = ['Paris (75)', 'Hauts-de-Seine (92)', 'Seine-Saint-Denis (93)', 'Val-de-Marne (94)', "Val-d'Oise (95)", 'Yvelines (78)'];
const groups = [...new Set(ZONES.map((z) => z.dept))]
  .sort((a, b) => (ORDER.indexOf(a) + 100) % 100 - (ORDER.indexOf(b) + 100) % 100)
  .map((dept) => ({ dept, zones: ZONES.filter((z) => z.dept === dept).sort((a, b) => a.name.localeCompare(b.name, 'fr', { numeric: true })) }));

const jsonLd = [breadcrumb([{ name: 'Accueil', url: '/' }, { name: 'Zones desservies', url: '/zones-desservies' }])];
---
<Base
  title="Zones d’intervention : Paris et Île-de-France | Soloris"
  description="Soloris intervient à Paris et dans toute l’Île-de-France pour vos DPE et diagnostics immobiliers. Déplacement inclus, créneau à confirmer."
  path="/zones-desservies"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span>/</span> <span aria-current="page">Zones desservies</span></nav>
  </div>

  <section>
    <div class="wrap">
      <div class="eyebrow">Zones desservies</div>
      <h1 class="sec-title" style="font-size:40px">Vos diagnostics à Paris et dans toute l’Île-de-France</h1>
      <p class="sec-intro">Indiquez le code postal du bien. Nous confirmons les prestations, le tarif et les disponibilités pour votre secteur.</p>
    </div>
  </section>

  <ReassuranceBar />

  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Notre zone d’intervention</div>
      <p class="sec-intro" style="max-width:none">Paris (75), Seine-et-Marne (77), Yvelines (78), Essonne (91), Hauts-de-Seine (92), Seine-Saint-Denis (93), Val-de-Marne (94) et Val-d’Oise (95). Le déplacement est inclus selon l’offre actuelle.</p>
      <h2 class="sec-title mt-5">Retrouvez votre secteur</h2>
      <p class="sec-intro" style="max-width:none;margin-bottom:24px">Consultez les pages des communes et arrondissements ci-dessous. Chaque page présente les prestations disponibles et, lorsque les sources le permettent, des données publiques contextualisées.</p>
      {groups.map((g) => (
        <div class="zgroup">
          <h3 class="sec-title" style="font-size:24px">{g.dept}</h3>
          <ul class="zchips">
            {g.zones.map((z) => <li><a href={`/diagnostic-immobilier-${z.slug}`}>{z.name}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-final">
    <div class="wrap">
      <h2>Votre commune n’est pas dans la liste&nbsp;?</h2>
      <p>La liste des pages n’est pas la liste exhaustive des communes desservies. Renseignez le code postal de votre bien dans la demande de devis pour vérifier l’organisation de l’intervention.</p>
      <div class="cta"><a href="/devis" class="btn-gold">Demander mon devis</a></div>
    </div>
  </section>
</Base>

<style>
  .zgroup { margin-bottom: 28px; }
  .zchips { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .zchips a { display: inline-block; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--blue); text-decoration: none; font-size: 14.5px; }
  .zchips a:hover { border-color: var(--blue); }
</style>
