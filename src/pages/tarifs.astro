---
/**
 * /tarifs — grille et diagnostics à l'unité (textes : dossier éditorial V2, oct. 2026).
 * Montants lus dans pricing.ts (aucun calcul recopié). JSON-LD : catalogue d'offres
 * distinctes (prix d'entrée de chaque prestation) + FAQ + fil d'Ariane.
 */
import Base from '../layouts/Base.astro';
import FormHero from '../components/FormHero.astro';
import ReassuranceBar from '../components/ReassuranceBar.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import { ADDONS, SURFACE_BANDS, MAISON_SUPP, MAISON_COPRO_SUPPLEMENT, DPE_FROM, DPE_MAISON_SUPP, AUDIT_FROM, AUDIT_TO, LOT_ANNEXE_PRICE, prixDes } from '../lib/pricing';
import { SITE } from '../lib/site';
import { CONDITIONS, DPE_FROM_MAX_M2, DPE_GRILLE_TEXTE, WORDING } from '../lib/wording';
import { faqPage, breadcrumb } from '../lib/jsonld';

// Diagnostics à l'unité : rendu public. La clé `cave` (supplément obsolète) n'est PAS affichée
// comme un supplément : l'annexe rattachée au logement est incluse dans le pack (règle inchangée
// du calculateur) ; le lot vendu seul relève de LOT_ANNEXE_PRICE.
const NOTES: Record<string, string> = { erp: 'inclus dans les packs', elec_gaz: 'forfait pour les deux prestations' };
const unites = ADDONS.filter((a) => a.key !== 'cave');

const offre = (name: string, min: number, max?: number) => ({
  '@type': 'Offer',
  itemOffered: { '@type': 'Service', name },
  priceCurrency: 'EUR',
  price: String(min),
  priceSpecification: {
    '@type': 'PriceSpecification',
    priceCurrency: 'EUR',
    minPrice: String(min),
    ...(typeof max === 'number' ? { maxPrice: String(max) } : {}),
    valueAddedTaxIncluded: true,
  },
  availability: 'https://schema.org/InStock',
  areaServed: SITE.areaServed.map((n) => ({ '@type': 'AdministrativeArea', name: n })),
});
const catalogue = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Tarifs des diagnostics immobiliers Soloris',
  url: new URL('/tarifs', SITE.url).href,
  itemListElement: [
    offre('DPE', DPE_FROM),
    offre('Pack diagnostics vente', prixDes('vente')),
    offre('Pack diagnostics location', prixDes('location')),
    offre('Audit énergétique', AUDIT_FROM, AUDIT_TO),
  ],
};

const faq = [
  { q: 'Les tarifs sont-ils TTC ?', a: 'Oui, les montants présentés sur cette page sont TTC. Le devis précise les prestations et le montant applicable à votre demande.' },
  { q: 'Le déplacement est-il inclus ?', a: `Oui, à Paris et dans toute l’Île-de-France selon le périmètre actuel de ${SITE.tradeName}.` },
  { q: 'Pourquoi le prix varie-t-il avec le bien ?', a: 'La mission et les diagnostics nécessaires peuvent différer selon le logement et les installations. Les catégories de prix ne remplacent pas la vérification des obligations applicables.' },
  { q: 'Le prix du formulaire est-il un devis ferme ?', a: 'Non. L’estimation se fonde sur les informations saisies. Le devis est confirmé avant l’intervention.' },
  { q: 'Dois-je payer une cave ajoutée au pack ?', a: 'L’annexe rattachée au logement est incluse dans le pack selon l’offre actuelle. Le cas d’un lot diagnostiqué seul relève d’un tarif distinct.' },
];

const jsonLd = [catalogue, faqPage(faq), breadcrumb([{ name: 'Accueil', url: '/' }, { name: 'Tarifs', url: '/tarifs' }])];
---
<Base
  title="Prix des diagnostics immobiliers à Paris | Soloris"
  description={`Consultez les tarifs Soloris : DPE dès ${DPE_FROM} € TTC, packs dès ${prixDes('vente')} € TTC selon le bien. Déplacement inclus et prix confirmé avant la visite.`}
  path="/tarifs"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span>/</span> <span aria-current="page">Tarifs</span></nav>
  </div>

  <!-- Formulaire en héros (page de destination des liens « Tarifs » Google Ads) -->
  <FormHero form={{ revealEstimation: true }}>
    <div class="eyebrow">Tarifs</div>
    <h1 class="sec-title v3-page-title">Les tarifs de vos diagnostics immobiliers</h1>
    <p class="sec-intro">Des prix TTC, le déplacement inclus et un devis confirmé avant l’intervention. Choisissez votre projet pour comprendre le tarif applicable à votre bien.</p>
    <!-- Résumé tarifaire qualifié (cahier P09) : repères lus dans pricing.ts, condition sous chaque
         montant. Ce n'est pas un second calculateur. -->
    <ul class="v3-resume" aria-label="Repères de prix">
      <li class="v3-resume-item">
        <a href="/dpe">DPE</a>
        <p class="v3-resume-prix">dès {DPE_FROM}&nbsp;€ TTC</p>
        <p class="v3-resume-cond">Appartement jusqu’à {DPE_FROM_MAX_M2}&nbsp;m² ; + {DPE_MAISON_SUPP}&nbsp;€ pour une maison.</p>
      </li>
      <li class="v3-resume-item">
        <a href="/diagnostics-vente">Packs vente et location</a>
        <p class="v3-resume-prix">dès {prixDes('vente')}&nbsp;€ TTC</p>
        <p class="v3-resume-cond">Appartement de {SURFACE_BANDS[0].maxIncl}&nbsp;m² maximum, construit depuis moins de 15 ans.</p>
      </li>
      <li class="v3-resume-item">
        <a href="/audit-energetique">Audit énergétique</a>
        <p class="v3-resume-prix">de {AUDIT_FROM} à {AUDIT_TO}&nbsp;€ TTC</p>
        <p class="v3-resume-cond">Selon le bien ; périmètre et délai confirmés au devis.</p>
      </li>
    </ul>
  </FormHero>

  <ReassuranceBar />

  <!-- Packs vente et location -->
  <section class="section-line">
    <div class="wrap" style="max-width:820px">
      <div class="eyebrow">Vendre ou louer</div>
      <h2 class="sec-title" style="font-size:28px">Packs vente et location</h2>
      <p class="tarif-big">Dès {prixDes('vente')}&nbsp;€ TTC</p>
      <p class="sec-intro">Dès {prixDes('vente')}&nbsp;€ TTC pour un appartement de {SURFACE_BANDS[0].maxIncl}&nbsp;m² maximum construit depuis moins de 15 ans. La grille varie selon la surface et la catégorie tarifaire du bien. Le prix d’une maison ajoute {MAISON_SUPP}&nbsp;€ au tarif appartement correspondant ; une maison en copropriété ajoute encore {MAISON_COPRO_SUPPLEMENT}&nbsp;€.</p>
      <p class="muted mt-2" style="font-size:14px">{CONDITIONS.pack}</p>
      <div class="flex-cta mt-4"><a href="#simulateur" class="btn-blue">Demander mon devis</a></div>
    </div>
  </section>

  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">Prestations énergie</div>
      <h2 class="sec-title">DPE seul & audit énergétique</h2>
      <div class="grid grid-2 mt-5">
        <div class="card" style="padding:26px 28px">
          <h3 style="font-family:var(--sora);font-weight:600;font-size:19px;color:var(--blue)">DPE : un tarif selon la surface</h3>
          <p style="font-family:var(--sora);font-weight:600;font-size:26px;color:var(--blue);margin:8px 0 4px">dès {DPE_FROM} € TTC</p>
          <p class="muted" style="font-size:14px">Dès {DPE_FROM}&nbsp;€ TTC pour un appartement jusqu’à {DPE_FROM_MAX_M2}&nbsp;m². Appartement : {DPE_GRILLE_TEXTE} selon la grille actuelle. Maison : ajouter {DPE_MAISON_SUPP}&nbsp;€ TTC. Déplacement inclus.</p>
          <p class="mt-2"><a href="/dpe" class="btn-ghost btn-sm">L'offre DPE</a></p>
        </div>
        <div class="card" style="padding:26px 28px">
          <h3 style="font-family:var(--sora);font-weight:600;font-size:19px;color:var(--blue)">Audit énergétique</h3>
          <p style="font-family:var(--sora);font-weight:600;font-size:26px;color:var(--blue);margin:8px 0 4px">de {AUDIT_FROM} à {AUDIT_TO} € TTC</p>
          <p class="muted" style="font-size:14px">De {AUDIT_FROM} à {AUDIT_TO}&nbsp;€ TTC selon le bien. Le périmètre de l’audit, le délai et le montant sont confirmés au devis.</p>
          <p class="mt-2"><a href="/audit-energetique" class="btn-ghost btn-sm">L'audit énergétique</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-line">
    <div class="wrap">
      <div class="eyebrow">À l’unité</div>
      <h2 class="sec-title">Diagnostics à l’unité</h2>
      <p class="sec-intro">Certains diagnostics peuvent être commandés séparément. Le forfait électricité + gaz correspond aux deux prestations, pas au prix de chacune prise isolément.</p>
      <div style="overflow-x:auto" class="mt-5" tabindex="0" role="region" aria-label="Tableau des tarifs à l’unité (défilement horizontal possible)">
        <table class="ptable">
          <thead><tr><th scope="col">Diagnostic</th><th scope="col">Tarif TTC</th></tr></thead>
          <tbody>
            {unites.map((a) => (
              <tr>
                <th scope="row" style="font-weight:500">{a.label}</th>
                <td class="price">{a.prefix}{a.price} €{NOTES[a.key] ? <small> · {NOTES[a.key]}</small> : null}</td>
              </tr>
            ))}
            <tr>
              <th scope="row" style="font-weight:500">Termites</th>
              <td class="price">Sur devis</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="price-note">Montants TTC. La liste des diagnostics applicables à votre bien est confirmée au devis.</p>

      <div style="margin-top:18px;background:var(--paper);border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:12px;padding:16px 20px">
        <strong style="font-family:var(--sora);color:var(--blue)">Annexes : deux situations différentes</strong>
        <span style="display:block;font-size:14px;margin-top:6px;color:var(--ink)">Une annexe rattachée au logement est incluse dans le pack. Une cave, un parking ou un box diagnostiqué seul est proposé à <span class="price">{LOT_ANNEXE_PRICE}&nbsp;€ TTC</span>, déplacement inclus.</span>
      </div>
    </div>
  </section>

  <section class="section-line">
    <div class="wrap" style="max-width:820px">
      <div class="eyebrow">Bon à savoir</div>
      <h2 class="sec-title" style="font-size:28px">Ce qui peut faire varier le prix</h2>
      <p class="sec-intro">La surface, le type de bien, les diagnostics nécessaires et les particularités de la mission. Un prélèvement, une analyse ou une prestation complémentaire ne doit jamais être ajouté sans information sur son périmètre et son prix lorsqu’il est nécessaire.</p>
    </div>
  </section>

  <Reviews limit={3} />

  <section class="cta-final">
    <div class="wrap">
      <h2>Demandez votre devis</h2>
      <p>{WORDING.engagementDevis}</p>
      <div class="cta"><a href="#simulateur" class="btn-gold">Demander mon devis</a></div>
    </div>
  </section>

  <Faq items={faq} title="Questions sur nos tarifs" />
</Base>

<style>
  .tarif-big { font-family: var(--sora); font-weight: 600; font-size: 26px; color: var(--blue); margin: 6px 0 8px; }
</style>
